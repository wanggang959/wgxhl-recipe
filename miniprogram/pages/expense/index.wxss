.expense-page{padding-top:26rpx}.page-title{font-size:40rpx;font-weight:700;margin:8rpx 0 22rpx}.bar{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.section-title{font-size:30rpx;font-weight:700}.section{padding:26rpx;margin-bottom:20rpx;border-radius:26rpx}.text-action,.danger-text{font-size:23rpx;color:#d56b1c}.danger-text{color:#c84646}.add{padding:10rpx 18rpx;border-radius:26rpx;background:#ff7614;color:#fff;font-size:23rpx;white-space:nowrap}.project-scroll,.filter-scroll{white-space:nowrap}.project-list,.chips{display:inline-flex;gap:10rpx}.project-list{padding:18rpx 0}.project-chip{min-width:190rpx;padding:20rpx;border:1rpx solid #f3ddca;border-radius:20rpx;background:#fff}.project-chip.active{border-color:#ff7614;background:#fff7ec}.project-name{font-size:26rpx;font-weight:700}.hint{font-size:22rpx;color:#98816e;line-height:1.5;margin-top:8rpx;word-break:break-all}.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin-top:20rpx}.stats>view{padding:14rpx;background:#fff7ed;border-radius:16rpx}.amount{font-size:25rpx;font-weight:700;word-break:break-all}.filter-row{display:flex;align-items:center;gap:12rpx}.filter-row+.filter-row{margin-top:12rpx}.filter-label{flex:none;width:48rpx;font-size:23rpx;color:#80634f}.filter-scroll{width:0;flex:1}.chip{padding:8rpx 18rpx;border:1rpx solid #f1d9c6;border-radius:25rpx;color:#805f48;font-size:23rpx;background:#fff}.chip.active{background:#ff7614;color:#fff;border-color:#ff7614}.list-heading{margin:24rpx 0 16rpx}.item-title{font-size:28rpx;font-weight:700;min-width:0;word-break:break-all}.status{flex:none;padding:6rpx 12rpx;border-radius:24rpx;background:#fff1dd;color:#c75d14;font-size:21rpx}.status.done{background:#fff0f1;color:#d43c45}.actual{color:#e46f17;font-size:24rpx;font-weight:700}.actions{display:flex;gap:18rpx;margin-top:14rpx}.empty{padding:36rpx;text-align:center;color:#9b8472;font-size:24rpx}.form .field{min-width:0;margin:18rpx 0}.label{font-size:23rpx;color:#80634f;margin-bottom:8rpx}.form input,.form textarea,.picker{box-sizing:border-box;width:100%;min-height:70rpx;line-height:70rpx;padding:0 16rpx;border:1rpx solid #f4d9c3;border-radius:16rpx;background:#fff;font-size:25rpx}.form textarea{height:110rpx;line-height:1.5;padding:12rpx 16rpx}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx}.primary{width:100%;height:74rpx;line-height:74rpx;padding:0;margin:20rpx 0 0;border-radius:18rpx;background:#ff7614;color:#fff;font-size:26rpx}.cancel{text-align:center;color:#d56b1c;font-size:24rpx;padding:20rpx}.error{padding:18rpx;margin-bottom:18rpx;border:1rpx solid #f3caca;border-radius:16rpx;background:#fff2f2;color:#b94040;font-size:24rpx}
