.recipe-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}
.recipe-card{overflow:hidden;border:1rpx solid #f1dfcf;border-radius:16rpx;background:#fff}
.recipe-card .cover-wrap{position:relative}
.recipe-card .cover{display:block;width:100%;height:240rpx;background:#fff1e4}
.recipe-card .placeholder{display:flex;align-items:center;justify-content:center;color:#d7a984;font-size:52rpx}
.recipe-card .favorite{position:absolute;top:12rpx;right:12rpx;display:flex;align-items:center;gap:4rpx;min-width:52rpx;height:52rpx;padding:0 10rpx;box-sizing:border-box;border-radius:26rpx;background:rgba(47,38,31,.42);color:#fff;font-size:27rpx;line-height:1}
.recipe-card .favorite.active{color:#ff5a5f}
.recipe-card .favorite.is-static{pointer-events:none}
.recipe-card .favorite .van-icon{font-size:32rpx;line-height:1}
.recipe-card .favorite-count{font-size:20rpx;font-weight:600}
.recipe-card .like-pill{position:absolute;right:12rpx;bottom:12rpx;display:flex;align-items:center;gap:4rpx;height:50rpx;padding:0 16rpx;border-radius:25rpx;background:rgba(17,24,39,.58);color:#fff;font-size:21rpx;font-weight:700;line-height:1}
.recipe-card .like-pill.active{background:#fff;color:#ea580c}
.recipe-card .like-pill.is-icon-only{width:50rpx;padding:0;justify-content:center}
.recipe-card .like-pill .van-icon{font-size:28rpx;line-height:1}
.recipe-card .like-pill.is-static{pointer-events:none}
.recipe-card .recipe-body{padding:18rpx}
.recipe-card .recipe-title{font-size:29rpx;font-weight:700;line-height:1.4;overflow-wrap:anywhere}
.recipe-card .recipe-meta,.recipe-card .recipe-owner{font-size:22rpx;color:#957a67;line-height:1.5;margin-top:8rpx;overflow-wrap:anywhere}
.recipe-card .recipe-owner{color:#c66320}
