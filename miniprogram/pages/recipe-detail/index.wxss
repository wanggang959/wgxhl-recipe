page{background:#fff9f2;color:#302722}.detail-page{padding-bottom:50rpx}.hero{display:block;width:100%;height:580rpx;background:#fff0df}.placeholder{display:flex;align-items:center;justify-content:center;color:#aa8a72}.summary{padding:24rpx 28rpx;background:#fffdfb}.tags{display:flex;gap:10rpx;flex-wrap:wrap}.tag{font-size:22rpx;color:#aa5d25;background:#fff0df;padding:6rpx 14rpx;border-radius:20rpx}.title{font-size:42rpx;font-weight:700;line-height:1.25;margin-top:12rpx;overflow-wrap:anywhere}.description{font-size:25rpx;line-height:1.6;color:#947a68;margin-top:14rpx;white-space:pre-wrap}.meta{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10rpx;margin-top:20rpx}.meta>view{min-width:0;padding:14rpx 6rpx;background:#fff8f1;border:1rpx solid #f5dfcd;border-radius:12rpx;text-align:center}.meta text{display:block;font-size:21rpx;color:#997e6b;overflow-wrap:anywhere}.meta .meta-value{font-size:23rpx;color:#423128;margin-top:5rpx;font-weight:600}.section{padding:24rpx 28rpx 0}.heading{font-size:32rpx;font-weight:700;margin-bottom:16rpx}.empty{font-size:24rpx;color:#af9581}.ingredients{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx}.ingredient{display:flex;align-items:center;gap:12rpx;min-width:0;background:#fff;border:1rpx solid #f4dfcd;border-radius:12rpx;padding:14rpx}.ingredient image,.ingredient-placeholder{width:76rpx;height:76rpx;flex:none;border-radius:8rpx;background:#fff1df}.ingredient-placeholder{display:flex;align-items:center;justify-content:center;color:#e79051}.ingredient-info{display:flex;flex-direction:column;gap:5rpx;min-width:0;font-size:25rpx;overflow-wrap:anywhere}.ingredient-info text:last-child{font-size:22rpx;color:#a08471}.step{display:flex;gap:18rpx;background:#fff;border:1rpx solid #f4dfcd;border-radius:12rpx;padding:20rpx;margin-bottom:14rpx}.step-number{display:flex;align-items:center;justify-content:center;width:50rpx;height:50rpx;flex:none;border-radius:50%;background:#ff7913;color:white;font-weight:700}.step-content{flex:1;min-width:0}.step-title{font-size:27rpx;font-weight:700}.step-description{font-size:25rpx;color:#806a5a;line-height:1.65;white-space:pre-wrap;margin-top:8rpx}.step-content image{display:block;width:100%;margin-top:14rpx;border-radius:8rpx}.tips{font-size:25rpx;color:#806a5a;line-height:1.6}.state{text-align:center;padding:60rpx;color:#9b8270}
