@import "../../assets/vant-icons.wxss";
.notice-layer{position:fixed;inset:0;z-index:1000;background:rgba(47,38,31,.3);display:flex;align-items:flex-end;justify-content:center}
.notice-panel{width:100%;height:78vh;max-height:calc(100vh - 50rpx);box-sizing:border-box;padding:28rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));border:1rpx solid #f5dfc7;border-radius:36rpx 36rpx 0 0;background:#fffaf2;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 -16rpx 44rpx rgba(154,52,18,.15)}
.notice-header{flex:none;display:flex;align-items:flex-start;justify-content:space-between}.eyebrow{color:#ed7117;font-size:24rpx;font-weight:600}.notice-heading{font-size:40rpx;font-weight:700;color:#30241d}.notice-subtitle{font-size:24rpx;color:#927866;margin-top:6rpx}.close-button{display:flex;align-items:center;justify-content:center;flex:none;width:72rpx;height:72rpx;border:1rpx solid #f5ddca;border-radius:50%;background:#fff;color:#f47716;font-size:38rpx;line-height:1}
.toolbar{display:flex;align-items:center;justify-content:space-between;padding:18rpx 20rpx;border:1rpx solid #f5ddca;border-radius:22rpx;background:#fff;margin:22rpx 0}.count{color:#806b5b;font-size:25rpx}.mark-all,.retry{display:inline-flex;align-items:center;justify-content:center;height:58rpx;padding:0 24rpx;border-radius:32rpx;color:#fff;background:#ff7614;font-size:24rpx}.mark-all.disabled{color:#a78b77;background:#f8dcc4}
.toolbar-actions{display:flex;align-items:center;gap:12rpx}.delete-read{display:inline-flex;align-items:center;justify-content:center;gap:6rpx;height:58rpx;padding:0 18rpx;border:1rpx solid #f4ddca;border-radius:32rpx;background:#fff;color:#a85e2c;font-size:24rpx;white-space:nowrap}.delete-read.disabled{color:#c5b3a6;background:#faf7f3}
.notice-scroll{height:0;min-height:0;flex:1}.notice-list{display:flex;flex-direction:column;gap:18rpx}.notice{display:flex;gap:18rpx;padding:22rpx;border:1rpx solid #f5ddca;border-radius:28rpx;background:#fff}.notice.unread{border-color:#ffc997;background:#fff8ed}.notice-icon{display:flex;align-items:center;justify-content:center;width:68rpx;height:68rpx;flex:none;border-radius:22rpx;background:#fff1e1;color:#f47716;font-size:34rpx}.unread .notice-icon{background:#ff7614;color:#fff}.notice-body{min-width:0;flex:1}.notice-title-row{display:flex;align-items:center;gap:12rpx}.notice-title{flex:1;min-width:0;font-size:30rpx;font-weight:700;color:#30241d;word-break:break-all}.unread-tag{flex:none;color:#fff;background:#ff7614;border-radius:24rpx;padding:4rpx 12rpx;font-size:21rpx}.notice-content{font-size:26rpx;line-height:1.55;color:#6f5a49;margin-top:10rpx;word-break:break-all}.notice-time{font-size:23rpx;color:#927866;margin-top:10rpx}.notice-actions{display:flex;gap:12rpx;margin-top:16rpx;flex-wrap:wrap}.action{display:inline-flex;align-items:center;justify-content:center;height:50rpx;padding:0 18rpx;border:1rpx solid #f4ddca;border-radius:28rpx;background:#fff;color:#c75d14;font-size:23rpx}.action.remove{color:#c74c45}.empty{padding:80rpx 24rpx;text-align:center;color:#927866;font-size:26rpx}.retry{margin:20rpx auto 0}.loading{text-align:center;color:#927866;font-size:23rpx;padding:20rpx}

