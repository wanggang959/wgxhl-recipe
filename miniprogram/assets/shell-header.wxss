@import "./vant-icons.wxss";
.app-header{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;margin:-32rpx -28rpx 20rpx;padding:20rpx 28rpx;background:#fff9f2;border-bottom:1rpx solid #f5e6d8}.app-name{font-size:30rpx;font-weight:700;line-height:1.2}.header-actions{display:flex;align-items:center;gap:12rpx}.bell-button,.header-add{position:relative;display:flex;align-items:center;justify-content:center;flex:none;width:68rpx;height:68rpx;line-height:1;padding:0;margin:0;border:1rpx solid #f5ddca;border-radius:50%;background:#fff;color:#ff7614;font-size:34rpx;box-sizing:border-box}.header-add{background:#ff7614;border-color:#ff7614;color:#fff;font-size:40rpx}.bell-badge{position:absolute;top:-5rpx;right:-5rpx;min-width:28rpx;height:28rpx;padding:0 4rpx;border-radius:20rpx;background:#e63d37;color:#fff;font-size:19rpx;line-height:28rpx;text-align:center;box-sizing:border-box}

