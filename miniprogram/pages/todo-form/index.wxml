<view class="page"><view class="eyebrow">家庭待办</view><view class="title">{{nextCycle ? '下一个周期' : form.id ? '编辑待办' : '新增待办'}}</view>
<view wx:if="{{loading}}" class="state">正在加载</view><view wx:elif="{{error}}" class="surface state">{{error}}</view>
<view wx:else class="surface form">
<view wx:if="{{nextCycle}}" class="cycle-tip">请填写下一个到期时间</view>
<view class="field"><view class="label">标题</view><input value="{{form.title}}" data-field="title" bindinput="field" placeholder="例如：服务器续费" maxlength="128" /></view>
<view class="field"><view class="label">分类</view><picker range="{{categories}}" range-key="label" value="{{categoryIndex}}" bindchange="categoryChange"><view class="picker">{{categories[categoryIndex].label}} <text>⌄</text></view></picker></view>
<view class="field"><view class="label">负责人</view><checkbox-group bindchange="owners" class="owners"><label wx:for="{{members}}" wx:key="id" class="owner"><checkbox value="{{item.id}}" checked="{{item.selected}}" color="#f5791b" />{{item.nickname || item.username}}</label></checkbox-group><view wx:if="{{!form.ownerIds.length}}" class="hint">未选择负责人时，将默认通知创建人</view></view>
<block wx:if="{{form.category === 'BIRTHDAY'}}"><view class="field"><view class="label">生日历法</view><picker range="{{calendarLabels}}" value="{{calendarIndex}}" bindchange="calendarChange"><view class="picker">{{calendarLabels[calendarIndex]}} <text>⌄</text></view></picker></view><view wx:if="{{form.dueCalendar === 'SOLAR'}}" class="field"><view class="label">公历生日</view><picker mode="date" value="{{form.birthdayDate}}" data-field="birthdayDate" bindchange="field"><view class="picker">{{form.birthdayDate || '选择生日'}}</view></picker></view><block wx:else><view class="field"><view class="label">出生年</view><input type="number" value="{{form.birthdayYear}}" data-field="birthdayYear" bindinput="field" placeholder="例如：1998" maxlength="4" /></view><view class="date-grid"><view class="field"><view class="label">农历月</view><input type="number" value="{{form.lunarDueMonth}}" data-field="lunarDueMonth" bindinput="field" /></view><view class="field"><view class="label">农历日</view><input type="number" value="{{form.lunarDueDay}}" data-field="lunarDueDay" bindinput="field" /></view></view><view class="switch-row"><text>闰月</text><switch checked="{{form.lunarDueLeap}}" data-field="lunarDueLeap" bindchange="toggle" color="#f5791b" /></view></block></block>
<view wx:else class="date-grid"><view class="field"><view class="label">日期</view><picker mode="date" value="{{form.date}}" data-field="date" bindchange="field"><view class="picker">{{form.date || '选择日期'}}</view></picker></view><view class="field"><view class="label">时间</view><picker mode="time" value="{{form.time}}" data-field="time" bindchange="field"><view class="picker">{{form.time || '选择时间'}}</view></picker></view></view>
<view class="field"><view class="label">备注</view><textarea value="{{form.description}}" data-field="description" bindinput="field" placeholder="补充说明" maxlength="500" /></view>
<view wx:if="{{form.category !== 'BIRTHDAY'}}" class="field"><view class="label">重复规则</view><picker range="{{repeats}}" range-key="label" value="{{repeatIndex}}" bindchange="repeatChange"><view class="picker">{{repeats[repeatIndex].label}} <text>⌄</text></view></picker></view>
<view class="field"><view class="label">通知方式</view><view class="switch-row"><text>站内通知</text><switch checked="{{form.notifySite}}" data-field="notifySite" bindchange="toggle" color="#f5791b" /></view><view class="switch-row"><text>邮箱通知</text><switch checked="{{form.notifyEmail}}" data-field="notifyEmail" bindchange="toggle" color="#f5791b" /></view><view class="switch-row"><text>App 通知</text><switch checked="{{form.notifyPush}}" data-field="notifyPush" bindchange="toggle" color="#f5791b" /></view></view>
<view class="field"><view class="label">提醒规则</view><checkbox-group bindchange="noticeChange" class="notices"><label wx:for="{{notices}}" wx:key="value"><checkbox value="{{'' + item.value}}" checked="{{item.selected}}" color="#f5791b" />{{item.label}}</label></checkbox-group></view>
<button class="primary" loading="{{saving}}" disabled="{{saving || !ready}}" bindtap="save">保存</button></view></view>
