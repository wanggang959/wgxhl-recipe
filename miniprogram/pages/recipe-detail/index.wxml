<view wx:if="{{loading}}" class="state">正在加载...</view><view wx:elif="{{error}}" class="state" bindtap="retry">{{error}}，点击重试</view><view wx:elif="{{recipe}}" class="detail-page">
  <image wx:if="{{recipe.coverUrl}}" class="hero" src="{{recipe.coverUrl}}" mode="aspectFill"/><view wx:else class="hero placeholder">暂无封面</view>
  <view class="summary"><view class="tags"><text wx:if="{{recipe.visibility==='public'}}" class="tag">公共</text><text wx:if="{{recipe.ownerName}}" class="tag">{{recipe.ownerName}}</text></view><view class="title">{{recipe.recipeName}}</view><view wx:if="{{recipe.recipeDesc}}" class="description">{{recipe.recipeDesc}}</view><view class="meta"><view><text>用时</text><text class="meta-value">{{recipe.timeLabel}}</text></view><view><text>难度</text><text class="meta-value">{{recipe.difficultyLabel}}</text></view><view><text>口味</text><text class="meta-value">{{recipe.tasteLabel}}</text></view><view><text>分类</text><text class="meta-value">{{recipe.categoryLabel}}</text></view></view></view>
  <view class="section"><view class="heading">食材</view><view wx:if="{{!ingredients.length}}" class="empty">暂无食材</view><view wx:else class="ingredients"><view wx:for="{{ingredients}}" wx:key="id" class="ingredient"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"/><view wx:else class="ingredient-placeholder">食</view><view class="ingredient-info"><text>{{item.ingredientName}}</text><text>{{item.amount || '-'}} {{item.unit || ''}}</text></view></view></view></view>
  <view class="section"><view class="heading">调料</view><view wx:if="{{!seasonings.length}}" class="empty">暂无调料</view><view wx:else class="ingredients"><view wx:for="{{seasonings}}" wx:key="id" class="ingredient"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"/><view wx:else class="ingredient-placeholder">调</view><view class="ingredient-info"><text>{{item.seasoningName}}</text><text>{{item.amount || '-'}} {{item.unit || ''}}</text></view></view></view></view>
  <view class="section"><view class="heading">制作步骤</view><view wx:if="{{!steps.length}}" class="empty">暂无步骤</view><view wx:for="{{steps}}" wx:key="id" class="step"><view class="step-number">{{item.stepNo}}</view><view class="step-content"><view class="step-title">{{item.stepTitle || '制作步骤'}}</view><view class="step-description">{{item.stepDesc || '暂无说明'}}</view><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="widthFix"/></view></view></view>
  <view wx:if="{{recipe.remark || recipe.recipeDesc}}" class="section tips"><view class="heading">小贴士</view><view>{{recipe.remark || recipe.recipeDesc}}</view></view>
</view>
