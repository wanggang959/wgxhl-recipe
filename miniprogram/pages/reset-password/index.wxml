<view class="page reset-page"><view class="title">找回密码</view>
  <view wx:if="{{state==='request'}}" class="panel"><view class="label">已验证的邮箱</view><input value="{{email}}" data-field="email" bindinput="input" maxlength="200" placeholder="请输入账号绑定的邮箱"/><view class="note">重置链接 30 分钟内有效，只能使用一次。</view><view wx:if="{{error}}" class="error">{{error}}</view><view class="primary-action {{busy?'disabled':''}}" role="button" bindtap="request">{{busy?'正在发送...':'发送重置邮件'}}</view><view class="secondary-action" bindtap="enterLink">已有重置链接</view></view>
  <view wx:elif="{{state==='sent'}}" class="panel"><view class="heading">请查收邮件</view><view class="note">如果邮箱已完成验证，你将收到重置链接，也请查看垃圾邮件。</view><view class="primary-action" bindtap="enterLink">输入重置链接</view><view class="secondary-action {{cooldown?'disabled':''}}" bindtap="requestAgain">{{cooldown ? cooldown + ' 秒后可重新申请' : '重新申请'}}</view></view>
  <view wx:elif="{{state==='link'}}" class="panel"><view class="label">邮件中的重置链接</view><textarea value="{{link}}" data-field="link" bindinput="input" maxlength="1000" placeholder="粘贴完整链接"/><view wx:if="{{error}}" class="error">{{error}}</view><view class="primary-action {{busy?'disabled':''}}" role="button" bindtap="checkLink">{{busy?'正在验证...':'验证链接'}}</view><view class="secondary-action" bindtap="requestAgain">重新申请邮件</view></view>
  <view wx:elif="{{state==='reset'}}" class="panel"><view class="label">新密码</view><input value="{{password}}" data-field="password" bindinput="input" password maxlength="64" placeholder="8 至 64 位"/><view class="label space">确认新密码</view><input value="{{confirmation}}" data-field="confirmation" bindinput="input" password maxlength="64" placeholder="再次输入新密码"/><view class="note">修改后，所有设备上的旧登录都会失效。</view><view wx:if="{{error}}" class="error">{{error}}</view><view class="primary-action {{busy?'disabled':''}}" role="button" bindtap="confirm">{{busy?'正在保存...':'重置密码'}}</view></view>
  <view wx:else class="panel"><view class="heading">密码已重置</view><view class="note">请用新密码重新登录。</view><view class="primary-action" bindtap="back">返回登录</view></view>
  <view wx:if="{{state!=='done'}}" class="back" bindtap="back">返回登录</view>
</view>
