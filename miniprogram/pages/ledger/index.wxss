page{background:#fff8f0;color:#382d27}.page{padding:28rpx}.header,.heading,.entry{display:flex;justify-content:space-between;align-items:center;gap:16rpx}.eyebrow{color:#ef761c;font-size:23rpx}.title{font-size:38rpx;font-weight:700}.primary{background:#f77716;color:white;border:0;border-radius:12rpx;font-size:26rpx}.add{margin:0;padding:0 22rpx;line-height:66rpx}.month{margin:28rpx 0 18rpx;color:#8f664c}.totals{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));padding:24rpx 0;border-top:1rpx solid #eee1d7;border-bottom:1rpx solid #eee1d7}.totals text{display:block}.totals text,.muted,.heading text{font-size:22rpx;color:#987f70}.totals .total-value{font-size:29rpx;font-weight:700;margin-top:8rpx;overflow-wrap:anywhere}.heading{font-size:30rpx;font-weight:700;margin:30rpx 0 18rpx}.categories,.types{display:flex;gap:12rpx;flex-wrap:wrap}.filter-row{margin-top:16rpx}.categories text,.types text{font-size:23rpx;padding:10rpx 16rpx;background:#fff2e5;border-radius:8rpx}.types .active{color:#fff;background:#f77716}.entry{padding:24rpx 0;border-bottom:1rpx solid #eee1d7;align-items:flex-start}.content{min-width:0;overflow-wrap:anywhere}.entry-title{font-weight:700;font-size:28rpx}.muted{margin-top:7rpx}.right{flex:none;text-align:right;font-size:27rpx}.right text{font-size:22rpx;color:#d66b20;margin-left:14rpx}.state{text-align:center;color:#987f70;padding:35rpx;font-size:24rpx}.mask{position:fixed;inset:0;z-index:10;background:rgba(0,0,0,.45);display:flex;align-items:flex-end}.sheet{width:100%;max-height:85vh;overflow:auto;box-sizing:border-box;background:#fffaf5;border-radius:18rpx 18rpx 0 0;padding:25rpx 28rpx calc(30rpx + env(safe-area-inset-bottom))}.sheet .heading{margin:0 0 20rpx}.label{font-size:23rpx;color:#8d705d;margin:16rpx 0 8rpx}.sheet input,.input{box-sizing:border-box;width:100%;background:#fff;border:1rpx solid #ead9cd;border-radius:8rpx;padding:16rpx;font-size:26rpx;min-height:70rpx}.save{margin-top:24rpx}
