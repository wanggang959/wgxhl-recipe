APP_PORT=9001
SPRING_PROFILES_ACTIVE=prod

SPRING_DATASOURCE_URL=jdbc:mysql://your-mysql-host:3306/recipe?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=recipe
SPRING_DATASOURCE_PASSWORD=your-password

MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-mail-auth-code

# Keep smtp until all three SES templates are approved and credentials are configured.
MAIL_PROVIDER=smtp
MAIL_FROM=
# SES sender: 王师傅生活助手 <no-reply@mail.wgxhl.space>
SES_SECRET_ID=
SES_SECRET_KEY=
SES_REGION=ap-guangzhou
SES_CODE_TEMPLATE_ID=0
SES_RESET_TEMPLATE_ID=0
SES_NOTIFICATION_TEMPLATE_ID=0
# Enable only after all SES template IDs point to HTML templates; keep false for plain text.
SES_HTML_TEMPLATES=false
# Unique account ID permitted to access the system administration console.
PLATFORM_ADMIN_USER_ID=
# 随机长串，构成回调地址 /mail/ses/callback/<token>，未配置时回调接口直接 404
SES_CALLBACK_TOKEN=

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_HOURS=168

COS_SECRET_ID=your-secret-id
COS_SECRET_KEY=your-secret-key
COS_REGION=ap-chengdu
COS_BUCKET=your-bucket
COS_BASE_URL=https://your-image-domain.example.com

# Generate once and keep this pair stable. Existing browser subscriptions depend on it.
# backend: java -cp "target/classes;$(cat target/classpath.txt)" nl.martijndwars.webpush.cli.Cli generate-key
PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key
PUSH_VAPID_PRIVATE_KEY=your-vapid-private-key
PUSH_VAPID_SUBJECT=mailto:admin@wgxhl.space
PUSH_TTL_SECONDS=604800
