<view wx:if="{{todo}}" class="mask" bindtap="close"><view class="sheet" catchtap="swallow"><view class="header"><view class="title">完成并记账</view><view class="close" bindtap="close">×</view></view><view class="details"><view class="name">{{todo.ledgerSetting.description}}</view><view class="muted">{{todo.ledgerSetting.category}} · {{todo.dueLabel}}</view></view><view class="label">付款人</view><picker range="{{members}}" range-key="nickname" bindchange="payer"><view class="input">{{payerName || '选择家庭成员'}} ▾</view></picker><view class="label">实际金额</view><input class="input" type="digit" value="{{amount}}" bindinput="amount" placeholder="输入实际金额" /><view wx:if="{{error}}" class="error">{{error}}</view><button class="primary" data-record="yes" bindtap="finish" loading="{{busy}}" disabled="{{busy || loading}}">完成并记账</button><button class="secondary" data-record="no" bindtap="finish" disabled="{{busy}}">仅完成，不记账</button></view></view>
