@import "../../assets/vant-icons.wxss";
.todo-page{padding-top:20rpx;padding-bottom:40rpx}
.app-header{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;margin:-20rpx -28rpx 20rpx;padding:20rpx 28rpx;background:#fff9f2;border-bottom:1rpx solid #f5e6d8}.app-name{font-size:30rpx;font-weight:700;line-height:1.2}.header-actions{display:flex;align-items:center;gap:12rpx}.bell-button,.header-add{position:relative;display:flex;align-items:center;justify-content:center;flex:none;width:68rpx;height:68rpx;line-height:1;padding:0;margin:0;border:1rpx solid #f5ddca;border-radius:50%;background:#fff;color:#ff7614;font-size:34rpx;box-sizing:border-box}.header-add{background:#ff7614;border-color:#ff7614;color:#fff;font-size:40rpx}.bell-badge{position:absolute;top:-5rpx;right:-5rpx;min-width:28rpx;height:28rpx;padding:0 4rpx;border-radius:20rpx;background:#e63d37;color:#fff;font-size:19rpx;line-height:28rpx;text-align:center;box-sizing:border-box}
.overview{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:26rpx;margin-bottom:22rpx;border-radius:28rpx}
.overview-main{min-width:0;flex:1}.overview-title{font-size:40rpx;font-weight:700;color:#28201c;margin:8rpx 0}.overview-detail{font-size:22rpx;color:#9a806e}
.add-button,.retry{display:inline-flex;align-items:center;justify-content:center;width:auto;min-width:0;height:64rpx;line-height:1;margin:0;padding:0 22rpx;border:0;border-radius:36rpx;background:#ff7614;color:#fff;font-size:24rpx;white-space:nowrap}
.filters{padding:16rpx 18rpx;margin-bottom:28rpx;border-radius:24rpx}.filter-row{display:flex;align-items:center;gap:14rpx;min-width:0}.filter-row+.filter-row{margin-top:14rpx}.filter-label{flex:none;width:54rpx;font-size:23rpx;color:#80634f}.filter-scroll{width:0;flex:1;white-space:nowrap}.filter-options{display:inline-flex;gap:10rpx;align-items:center}.filter-chip{display:inline-flex;align-items:center;justify-content:center;height:52rpx;padding:0 19rpx;border:1rpx solid #f0dac7;border-radius:30rpx;color:#805b42;background:#fff;font-size:24rpx;white-space:nowrap}.filter-chip.active{background:#ff7614;border-color:#ff7614;color:#fff;font-weight:600}
.group{margin-bottom:26rpx}.group-title{font-size:29rpx;font-weight:700;color:#29211e;margin:0 0 16rpx 3rpx}.todo{display:flex;gap:20rpx;padding:22rpx;margin-bottom:16rpx;border-radius:26rpx}.todo-icon{display:flex;align-items:center;justify-content:center;flex:none;width:70rpx;height:70rpx;border-radius:20rpx;background:#fff5e9;color:#ff7614;font-size:27rpx;font-weight:600}.todo-content{flex:1;min-width:0}.todo-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14rpx}.todo-title{font-weight:700;font-size:27rpx;color:#302621;min-width:0;word-break:break-all}.tag{flex:none;font-size:21rpx;color:#d45e0a;background:#fff0dd;border-radius:22rpx;padding:5rpx 12rpx}.detail{font-size:22rpx;color:#927866;margin-top:10rpx;line-height:1.5;word-break:break-all}.description{display:inline-block;max-width:100%;font-size:22rpx;color:#805d44;background:#fff5e9;border-radius:20rpx;padding:6rpx 12rpx;margin-top:12rpx;box-sizing:border-box;word-break:break-all}
.actions{display:flex;align-items:center;gap:10rpx;margin-top:18rpx;flex-wrap:wrap}.actions button{display:inline-flex;align-items:center;justify-content:center;flex:none;width:auto;min-width:0;height:54rpx;line-height:1;font-size:23rpx;color:#805a43;background:#fff9f2;border:1rpx solid #f2d7c2;border-radius:30rpx;padding:0 18rpx;margin:0}.actions .done-action{background:#ff7614;color:#fff;border-color:#ff7614}.actions .is-disabled{background:#f6dac6;color:#a5785f;border-color:#f6dac6}.actions .delete-action{color:#cc4b42;background:#fff7f5}.retry{margin:18rpx auto 0}
.overview-actions{display:flex;flex-direction:column;gap:12rpx;flex:none;align-items:stretch}.overview-actions button{display:flex;align-items:center;justify-content:center;gap:6rpx;height:64rpx;padding:0 20rpx;border-radius:28rpx;font-size:23rpx;font-weight:600;line-height:1;white-space:nowrap;margin:0}.overview-actions .summary-button{background:#ff7614;color:#fff;border:1rpx solid #ff7614;box-shadow:0 8rpx 16rpx rgba(249,115,22,.18)}.overview-actions .add-button{background:#fff;color:#ff7614;border:1rpx solid #fed7aa;box-shadow:none}.overview-actions .van-icon{font-size:26rpx;line-height:1}
.todo-icon .van-icon{font-size:38rpx}
.detail{display:flex;align-items:flex-start;gap:8rpx}.detail .van-icon{flex:none;color:#b77955;margin-top:3rpx}.detail>text:last-child{min-width:0;overflow-wrap:anywhere}
.actions .delete-action{width:58rpx;padding:0}
.group-title{font-size:32rpx}
.todo{gap:24rpx;padding:28rpx;border-radius:32rpx;box-shadow:0 12rpx 26rpx rgba(154,52,18,.07)}
.todo-icon{width:82rpx;height:82rpx;border-radius:24rpx;border:1rpx solid #ffedd5;box-sizing:border-box}
.todo-title{font-size:32rpx;line-height:1.3}
.tag{font-size:24rpx;padding:6rpx 16rpx}
.detail{font-size:24rpx;line-height:1.45}
.description{font-size:24rpx;padding:8rpx 14rpx}
.actions{gap:14rpx;margin-top:26rpx}
.actions button{height:64rpx;font-size:26rpx;padding:0 22rpx}
.actions .delete-action{width:68rpx;padding:0}


.refresh-error{padding:14rpx 18rpx;margin-bottom:14rpx;color:#a85826;background:#fff1df;border-radius:12rpx;font-size:23rpx}
