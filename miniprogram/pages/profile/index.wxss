@import "../../assets/vant-icons.wxss";
.van-icon-plus::before{content:"\e6fa"}.van-icon-apps-o::before{content:"\e665"}.van-icon-logistics::before{content:"\e6df"}.van-icon-balance-list-o::before{content:"\e673"}.van-icon-arrow::before{content:"\e660"}.van-icon-friends-o::before{content:"\e6c2"}
.profile-page{padding-bottom:calc(150rpx + env(safe-area-inset-bottom))}
.app-header{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;margin:-32rpx -28rpx 20rpx;padding:20rpx 28rpx;background:#fff9f2;border-bottom:1rpx solid #f5e6d8}.app-name{font-size:30rpx;font-weight:700;line-height:1.2}.header-actions{display:flex;align-items:center;gap:12rpx}.bell-button,.header-add{position:relative;display:flex;align-items:center;justify-content:center;flex:none;width:68rpx;height:68rpx;line-height:1;padding:0;margin:0;border:1rpx solid #f5ddca;border-radius:50%;background:#fff;color:#ff7614;font-size:34rpx;box-sizing:border-box}.header-add{background:#ff7614;border-color:#ff7614;color:#fff;font-size:40rpx}.bell-badge{position:absolute;top:-5rpx;right:-5rpx;min-width:28rpx;height:28rpx;padding:0 4rpx;border-radius:20rpx;background:#e63d37;color:#fff;font-size:19rpx;line-height:28rpx;text-align:center;box-sizing:border-box}
.profile-card{display:flex;align-items:center;gap:24rpx;padding:26rpx;margin-bottom:22rpx;border-radius:28rpx;box-shadow:0 10rpx 26rpx rgba(154,52,18,.06)}.profile-avatar{width:100rpx;height:100rpx;flex:none;border-radius:26rpx;background:#fff0dc}.profile-main{min-width:0}.profile-name{font-size:36rpx;line-height:1.25;font-weight:700;word-break:break-all}.profile-role{font-size:23rpx;color:#937e6b;margin-top:6rpx}
.section{padding:26rpx;margin-bottom:22rpx;border-radius:28rpx;box-shadow:0 10rpx 26rpx rgba(154,52,18,.05)}.section-title{font-size:30rpx;font-weight:700;color:#30241d}.section-caption{font-size:21rpx;color:#9b8472;margin-top:6rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;min-height:68rpx;border-bottom:1rpx solid #faf1e9;font-size:25rpx}.row-value{max-width:60%;text-align:right;color:#998879;word-break:break-all}.link-row .van-icon{color:#b6a193}.outline-command{display:inline-flex;align-items:center;justify-content:center;height:58rpx;padding:0 22rpx;margin-top:18rpx;border:1rpx solid #f9a869;border-radius:32rpx;color:#dc6c20;font-size:24rpx}
.shortcut-grid{display:flex;gap:16rpx;margin-bottom:22rpx}.shortcut{display:flex;align-items:center;justify-content:center;gap:8rpx;flex:1;height:82rpx;border:1rpx solid #f5ddca;border-radius:22rpx;background:#fff;color:#76543c;font-size:25rpx}.shortcut .van-icon{font-size:27rpx}
.push-setting{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:20rpx 0;padding:18rpx;border:1rpx solid #f6dfc9;border-radius:20rpx;background:#fff8f0}.push-title{font-size:25rpx;font-weight:700}.push-caption{font-size:21rpx;color:#9b8472;margin-top:4rpx}.pending{flex:none;color:#bb8d6d;font-size:22rpx}.logout{display:flex;align-items:center;justify-content:center;height:70rpx;margin-top:18rpx;border:1rpx solid #ed4d50;border-radius:36rpx;color:#e74146;font-size:25rpx}
.tool-entry{display:flex;align-items:center;gap:16rpx;margin-top:16rpx;padding:16rpx;border:1rpx solid #f8e5d2;border-radius:20rpx;background:#fffaf4;color:#80634f}.tool-icon,.member-heading-icon{display:flex;align-items:center;justify-content:center;flex:none;width:64rpx;height:64rpx;border-radius:18rpx;background:#fff0df;color:#ff7614;font-size:32rpx}.tool-copy{flex:1;min-width:0}.tool-title{font-size:25rpx;font-weight:700;color:#392e28}.tool-subtitle{margin-top:5rpx;color:#a18a78;font-size:21rpx;line-height:1.4}
.member-heading{display:flex;align-items:center;gap:15rpx}.member-heading-copy{flex:1;min-width:0}.member-add{flex:none;padding:12rpx 16rpx;border-radius:30rpx;background:#ff7614;color:#fff;font-size:22rpx;white-space:nowrap}.member-list{margin-top:20rpx}.member-card{display:flex;gap:18rpx;padding:20rpx;border:1rpx solid #f5e1cf;border-radius:22rpx;background:#fff;margin-top:14rpx}.member-avatar{width:80rpx;height:80rpx;border-radius:20rpx;flex:none;background:#fff0df}.member-info{flex:1;min-width:0}.member-top{display:flex;justify-content:space-between;gap:8rpx;align-items:flex-start}.member-name{font-weight:700;font-size:27rpx;min-width:0;word-break:break-all}.role-badge{flex:none;color:#c75d14;background:#fff5e9;border-radius:20rpx;padding:5rpx 10rpx;font-size:20rpx}.member-line{font-size:22rpx;line-height:1.5;color:#917a6a;margin-top:6rpx;word-break:break-all}.birthday{color:#db6a22}.member-state{text-align:center;color:#9b8472;font-size:24rpx;padding:32rpx 0}.retry{color:#f47716}
.password-layer{position:fixed;inset:0;z-index:1000;background:rgba(47,38,31,.35);display:flex;align-items:flex-end}
.password-panel{width:100%;box-sizing:border-box;padding:28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));border-radius:32rpx 32rpx 0 0;background:#fffaf4}
.password-head{display:flex;align-items:center;justify-content:space-between}.password-title{font-size:32rpx;font-weight:700}.password-close{display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;border:1rpx solid #f5ddca;border-radius:50%;color:#d36a1d;font-size:36rpx;line-height:1;background:#fff}
.password-hint{font-size:23rpx;color:#9b8472;margin:8rpx 0 20rpx}.password-field{font-size:24rpx;color:#765b47;margin-top:16rpx}.password-field input{box-sizing:border-box;height:72rpx;margin-top:8rpx;padding:0 18rpx;border:1rpx solid #f5ddca;border-radius:16rpx;background:#fff;font-size:26rpx;color:#392e28}.password-error{margin-top:16rpx;color:#c83636;font-size:24rpx}.password-submit{height:76rpx;line-height:76rpx;margin-top:26rpx;border-radius:38rpx;background:#ff7614;color:#fff;font-size:27rpx;font-weight:600}.password-submit[disabled]{background:#f8dcc4;color:#a78b77}
.password-panel{max-height:85vh;overflow-y:auto}
.password-field{display:flex;align-items:center;gap:16rpx;min-height:78rpx;margin:0;border-bottom:1rpx solid #f4e9de}
.password-field>view{width:150rpx;flex:none}
.password-field input{flex:1;min-width:0;height:72rpx;margin:0;padding:0;border:0;background:transparent}
.password-actions{display:flex;gap:16rpx;margin-top:22rpx}
.password-actions button{display:flex;align-items:center;justify-content:center;flex:none;width:112rpx;height:64rpx;line-height:1;margin:0;padding:0;border-radius:32rpx;font-size:25rpx}
.password-cancel{background:#fff;border:1rpx solid #f5ddca;color:#765b47}
.member-edit{display:inline-flex;align-items:center;justify-content:center;margin-top:12rpx;padding:8rpx 18rpx;border-radius:25rpx;background:#fff3e6;color:#d36517;font-size:22rpx}
.member-action-disabled{opacity:.55}
.member-remove{margin-left:10rpx;background:#fff3f3;color:#c84747}
.wechat-state{display:flex;align-items:center;gap:10rpx;color:#998879;font-size:23rpx}

