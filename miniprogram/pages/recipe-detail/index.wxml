<view wx:if="{{loading}}" class="state">正在加载...</view><view wx:elif="{{error}}" class="state" bindtap="retry">{{error}}，点击重试</view><view wx:elif="{{recipe}}" class="detail-page">
  <view class="hero-wrap">
    <image wx:if="{{recipe.coverUrl}}" class="hero" src="{{recipe.coverUrl}}" mode="aspectFill" bindtap="previewImage" data-src="{{recipe.coverUrl}}"/>
    <view wx:else class="hero placeholder">暂无封面</view>
    <view wx:if="{{!guest}}" class="hero-favorite {{isFavorite ? 'active' : ''}}" role="button" aria-label="{{isFavorite ? '取消收藏' : '收藏菜谱'}}" bindtap="toggleFavorite"><text class="van-icon {{isFavorite ? 'van-icon-like' : 'van-icon-like-o'}}"></text><text wx:if="{{recipe.favoriteCount > 0}}" class="hero-count">{{recipe.favoriteCount}}</text></view>
    <view wx:elif="{{recipe.favoriteCount > 0}}" class="hero-favorite is-static"><text class="van-icon van-icon-like-o"></text><text class="hero-count">{{recipe.favoriteCount}}</text></view>
  </view>
  <view class="summary">
    <view class="tags"><text wx:if="{{recipe.status === '下架'}}" class="tag offline">已下架</text><text wx:if="{{recipe.visibility === 'public'}}" class="tag">公共</text><text wx:if="{{recipe.ownerName}}" class="tag">{{recipe.ownerName}}</text><text class="tag version">v{{recipe.versionLabel}}</text></view>
    <view class="title">{{recipe.recipeName}}</view>
    <view wx:if="{{!guest}}" class="title-actions">
      <view class="action-pill {{recipe.liked ? 'active' : ''}}" role="button" bindtap="toggleLike"><text class="van-icon {{recipe.liked ? 'van-icon-good-job' : 'van-icon-good-job-o'}}"></text><text>{{recipe.likeCount > 0 ? recipe.likeCount : '点赞'}}</text></view>
      <view class="action-pill {{isWanted ? 'active' : ''}}" role="button" bindtap="toggleWant">{{isWanted ? '已想吃' : '想吃'}}</view>
      <view wx:if="{{isSuperAdmin}}" class="action-pill" role="button" bindtap="toggleStatus">{{recipe.status === '下架' ? '恢复上架' : '下架'}}</view>
      <view wx:if="{{isOwner}}" class="action-pill" role="button" bindtap="edit">编辑</view>
      <view wx:if="{{isOwner}}" class="action-pill danger" role="button" bindtap="remove">删除</view>
    </view>
    <view wx:else class="title-actions"><view wx:if="{{recipe.likeCount > 0}}" class="action-pill is-static"><text class="van-icon van-icon-good-job-o"></text><text>{{recipe.likeCount}}</text></view><view wx:if="{{recipe.favoriteCount > 0}}" class="action-pill is-static">收藏 {{recipe.favoriteCount}}</view></view>
    <view wx:if="{{recipe.recipeDesc}}" class="description">{{recipe.recipeDesc}}</view>
    <view class="meta"><view><text>用时</text><text class="meta-value">{{recipe.timeLabel}}</text></view><view><text>难度</text><text class="meta-value">{{recipe.difficultyLabel}}</text></view><view><text>口味</text><text class="meta-value">{{recipe.tasteLabel}}</text></view><view><text>分类</text><text class="meta-value">{{recipe.categoryLabel}}</text></view></view>
    <view wx:if="{{recipe.servingCount}}" class="serving">适合 {{recipe.servingCount}}</view>
  </view>
  <view class="section"><view class="heading">食材</view><view wx:if="{{!ingredients.length}}" class="empty">暂无食材</view><view wx:else class="ingredients"><view wx:for="{{ingredients}}" wx:key="id" class="ingredient"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" bindtap="previewImage" data-src="{{item.imageUrl}}"/><view wx:else class="ingredient-placeholder">食</view><view class="ingredient-info"><text>{{item.ingredientName}}</text><text>{{item.amount || '-'}} {{item.unit || ''}}</text></view></view></view></view>
  <view class="section"><view class="heading">调料</view><view wx:if="{{!seasonings.length}}" class="empty">暂无调料</view><view wx:else class="ingredients"><view wx:for="{{seasonings}}" wx:key="id" class="ingredient"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" bindtap="previewImage" data-src="{{item.imageUrl}}"/><view wx:else class="ingredient-placeholder">调</view><view class="ingredient-info"><text>{{item.seasoningName}}</text><text>{{item.amount || '-'}} {{item.unit || ''}}</text></view></view></view></view>
  <view class="section"><view class="heading">制作步骤</view><view wx:if="{{!steps.length}}" class="empty">暂无步骤</view><view wx:for="{{steps}}" wx:key="id" class="step"><view class="step-number">{{item.stepNo}}</view><view class="step-content"><view class="step-title">{{item.stepTitle || '制作步骤'}}</view><view class="step-description">{{item.stepDesc || '暂无说明'}}</view><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="widthFix" bindtap="previewImage" data-src="{{item.imageUrl}}"/></view></view></view>
  <view wx:if="{{recipe.remark || recipe.recipeDesc}}" class="section tips"><view class="heading">小贴士</view><view>{{recipe.remark || recipe.recipeDesc}}</view></view>
</view>
