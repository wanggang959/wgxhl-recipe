.trip-report-screen { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 120; display: flex; flex-direction: column; background: #edf6fb; color: #173141; font-variant-numeric: tabular-nums; }
.trip-report-scroll { flex: 1; height: 0; min-height: 0; }
.report-head { flex: none; display: grid; grid-template-columns: 84rpx minmax(0,1fr) 84rpx; align-items: center; gap: 14rpx; padding: 10rpx 22rpx; background: #17618d; color: #fff; text-align: center; font-size: 32rpx; font-weight: 700; }
.report-head > view { display: grid; place-items: center; width: 84rpx; height: 84rpx; font-size: 40rpx; }
.report-vehicle { display: grid; grid-template-columns: 210rpx minmax(0,1fr); align-items: center; gap: 26rpx; padding: 24rpx 30rpx 39rpx; background: #17618d; color: #fff; }
.report-vehicle image { width: 210rpx; height: 142rpx; background: #e3f0f8; border-radius: 14rpx; }
.report-vehicle-copy { display: grid; gap: 7rpx; min-width: 0; overflow-wrap: anywhere; }
.report-vehicle-copy > view { font-size: 37rpx; font-weight: 700; }
.report-vehicle-copy text { font-size: 24rpx; color: #e6f4fb; }
.report-content { padding: 25rpx 26rpx calc(44rpx + env(safe-area-inset-bottom)); }
.report-period { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 9rpx 18rpx; margin-bottom: 20rpx; color: #4c6574; font-size: 23rpx; }
.report-period text:first-child { font-weight: 700; }
.report-highlights { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 15rpx; }
.report-highlights > view { display: grid; gap: 7rpx; min-width: 0; padding: 20rpx 22rpx; border-radius: 13rpx; background: #deedf4; color: #174e68; font-size: 24rpx; }
.report-highlights > view:last-child { background: #e3f3ea; color: #1b5942; }
.report-highlights .report-number { font-size: 46rpx; font-weight: 700; overflow-wrap: anywhere; }
.report-notice { margin-top: 18rpx; padding: 14rpx 18rpx; border-left: 5rpx solid #a4672c; background: #fff4e5; color: #734515; font-size: 24rpx; }
.report-band { margin-top: 26rpx; border-top: 1px solid #cadde7; padding-top: 18rpx; }
.report-section-title { font-size: 31rpx; font-weight: 700; }
.report-metrics { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 19rpx 12rpx; margin-top: 15rpx; color: #4c6574; font-size: 23rpx; overflow-wrap: anywhere; }
.report-metrics > view > view { margin-top: 4rpx; }
.report-metrics .report-number { color: #173141; font-size: 33rpx; font-weight: 700; }
