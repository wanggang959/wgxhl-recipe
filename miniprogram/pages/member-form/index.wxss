.member-form-page{padding-top:26rpx;padding-bottom:40rpx}.page-title{font-size:40rpx;font-weight:700;margin:8rpx 0 22rpx}.form{padding:26rpx;border-radius:28rpx}.field{margin-bottom:20rpx;min-width:0}.label{font-size:23rpx;color:#80634f;margin-bottom:8rpx}.field input,.picker{box-sizing:border-box;width:100%;height:74rpx;line-height:74rpx;padding:0 18rpx;border:1rpx solid #f4d9c3;border-radius:16rpx;background:#fff;color:#392e28;font-size:26rpx}.field input[disabled]{background:#faf5f0;color:#a99485}.placeholder{color:#b29d8d}.hint{font-size:21rpx;color:#a48c79;margin-top:6rpx;line-height:1.4}.segmented{display:flex;gap:10rpx}.segment{flex:1;padding:16rpx;text-align:center;border:1rpx solid #f3dbc8;border-radius:18rpx;background:#fff;color:#80634f;font-size:25rpx}.segment.active{border-color:#ff7614;background:#fff0df;color:#df6818;font-weight:600}.lunar-fields{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:12rpx}.leap{display:flex;align-items:center;margin:-8rpx 0 18rpx;font-size:24rpx;color:#80634f}.leap checkbox{transform:scale(.75);transform-origin:left center}.avatar-scroll{white-space:nowrap}.avatar-list{display:inline-flex;gap:12rpx}.avatar-option{box-sizing:border-box;width:82rpx;height:82rpx;border:2rpx solid transparent;border-radius:20rpx;padding:3rpx}.avatar-option.selected{border-color:#ff7614;background:#fff1e2}.avatar-option image{width:100%;height:100%;border-radius:16rpx}.error{margin:16rpx 0;color:#bd3434;font-size:24rpx;line-height:1.4}.save{height:76rpx;line-height:76rpx;width:100%;padding:0;margin:24rpx 0 0;border-radius:36rpx;background:#ff7614;color:#fff;font-size:27rpx;font-weight:600}.save[disabled]{background:#f8dcc4;color:#a78b77}
