@import "../../assets/vant-icons.wxss";
@import "../../assets/recipe-card.wxss";
.home-page{padding-top:20rpx;padding-bottom:40rpx}.app-header{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;margin:-20rpx -28rpx 20rpx;padding:20rpx 28rpx;background:#fff9f2;border-bottom:1rpx solid #f5e6d8}.app-name{font-size:30rpx;font-weight:700;line-height:1.2}.header-actions{display:flex;align-items:center;gap:12rpx}.bell-button,.header-add{position:relative;display:flex;align-items:center;justify-content:center;width:68rpx;height:68rpx;border:1rpx solid #f5ddca;border-radius:50%;background:#fff;color:#ff7614;font-size:34rpx;box-sizing:border-box}.header-add{background:#ff7614;color:white;font-size:40rpx}.bell-badge{position:absolute;top:-5rpx;right:-5rpx;min-width:28rpx;height:28rpx;padding:0 4rpx;border-radius:20rpx;background:#e63d37;color:white;font-size:19rpx;line-height:28rpx;text-align:center}.hero{display:flex;flex-direction:column;gap:10rpx;padding:28rpx;background:#fff0df;border:1rpx solid #f5dfcb;border-radius:16rpx;margin-bottom:20rpx}.hero-kicker{font-size:23rpx;color:#dd6b20}.hero-title{font-size:37rpx;font-weight:700;color:#392d26;overflow-wrap:anywhere}.hero-copy{font-size:24rpx;color:#967965}.hero-cta{align-self:flex-start;margin-top:8rpx;padding:14rpx 28rpx;border-radius:32rpx;background:#ff7614;color:#fff;font-size:25rpx;font-weight:600}
.switches{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:18rpx}.segmented{display:flex;border:1rpx solid #f2dfd0;border-radius:32rpx;background:#fff;padding:4rpx;flex:none}.segment{padding:8rpx 14rpx;border-radius:28rpx;font-size:22rpx;color:#8b7463;white-space:nowrap}.segment.active{background:#fff0e1;color:#ea6d0d}.sort .segment.active{background:#f1f2f4;color:#333}.guest-label{font-size:24rpx;color:#9c7358}.search{display:flex;align-items:center;gap:14rpx;background:#fff;border:1rpx solid #f2dfd0;border-radius:40rpx;padding:8rpx 10rpx 8rpx 20rpx;margin-bottom:18rpx;color:#f47716}.search input{flex:1;min-width:0;font-size:26rpx;color:#382e29}.search-button{padding:12rpx 24rpx;border-radius:32rpx;background:#fff0df;font-size:24rpx}.category-scroll{width:100%;white-space:nowrap}.category-list{display:inline-flex;gap:12rpx}.category{padding:12rpx 20rpx;border:1rpx solid #f0dac7;border-radius:30rpx;background:white;color:#80634f;font-size:24rpx}.category.active{background:#fff0df;color:#df6410;border-color:#ffceaa}.inline-error{font-size:22rpx;color:#b45139;padding:12rpx}.list-header{display:flex;justify-content:space-between;align-items:center;margin:28rpx 0 18rpx;font-size:32rpx;font-weight:700}.list-header text:last-child{font-size:23rpx;font-weight:400;color:#9b806c}.state{text-align:center;color:#9b8270;font-size:24rpx;padding:40rpx 10rpx}
.recipe-card .like-pill{right:auto;left:12rpx}
.recipe-card .want-cart{position:absolute;right:12rpx;bottom:12rpx;display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;border-radius:50%;background:rgba(47,38,31,.42);color:#fff;font-size:28rpx}
.recipe-card .want-cart.active{background:#fff;color:#ea580c}
.want-layer{position:fixed;inset:0;z-index:600;background:rgba(47,38,31,.4);display:flex;align-items:flex-end}
.want-sheet{box-sizing:border-box;width:100%;padding:28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));border-radius:24rpx 24rpx 0 0;background:#fffaf2}
.want-title{text-align:center;font-size:30rpx;font-weight:700;overflow-wrap:anywhere}.want-actions{display:flex;gap:16rpx;margin-top:20rpx}.want-actions view,.want-submit{display:flex;align-items:center;justify-content:center;flex:1;height:80rpx;border-radius:40rpx;background:#ff7614;color:#fff;font-size:27rpx;font-weight:600}.want-date{display:flex;align-items:center;justify-content:space-between;margin:24rpx 0;color:#80634f;font-size:25rpx}.want-date picker{padding:14rpx 20rpx;background:#fff;border:1rpx solid #f0dac7;border-radius:10rpx}.want-submit{width:100%}.want-submit.busy{opacity:.6}.want-cancel{text-align:center;padding:22rpx;color:#8b7463;font-size:25rpx}
.offline-toggle{display:inline-flex;margin-top:16rpx;padding:8rpx 16rpx;border:1rpx solid #f0dac7;border-radius:24rpx;background:#fff;color:#80634f;font-size:22rpx}
.recipe-card .offline-badge{position:absolute;top:12rpx;left:12rpx;padding:6rpx 12rpx;border-radius:20rpx;background:rgba(17,24,39,.72);color:#fff;font-size:21rpx}
