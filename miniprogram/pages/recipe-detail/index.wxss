@import "../../assets/vant-icons.wxss";
page{background:#fff9f2;color:#302722}.detail-page{padding-bottom:50rpx}.hero-wrap{position:relative}.hero{display:block;width:100%;height:580rpx;background:#fff0df}.placeholder{display:flex;align-items:center;justify-content:center;color:#aa8a72}.hero-favorite{position:absolute;right:24rpx;bottom:24rpx;display:flex;align-items:center;gap:6rpx;min-width:64rpx;height:64rpx;padding:0 16rpx;box-sizing:border-box;border-radius:32rpx;background:rgba(47,38,31,.45);color:#fff;font-size:34rpx;line-height:1}.hero-favorite.active{color:#ff5a5f}.hero-favorite.is-static{pointer-events:none}.hero-favorite .van-icon{font-size:34rpx;line-height:1}.hero-count{font-size:24rpx;font-weight:600}.summary{padding:24rpx 28rpx;background:#fffdfb}.tags{display:flex;gap:10rpx;flex-wrap:wrap}.tag{font-size:22rpx;color:#aa5d25;background:#fff0df;padding:6rpx 14rpx;border-radius:20rpx}.tag.offline{background:#3f3f46;color:#fff}.tag.version{background:#f3f4f6;color:#4b5563}.title{font-size:42rpx;font-weight:700;line-height:1.25;margin-top:12rpx;overflow-wrap:anywhere}.title-actions{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}.action-pill{height:56rpx;padding:0 22rpx;border:1rpx solid #ffd8b8;border-radius:28rpx;background:#fff;color:#c2410c;font-size:24rpx;display:flex;align-items:center}.action-pill.active{background:#fff1e6;border-color:#fb923c;font-weight:600}.action-pill .van-icon{font-size:26rpx;margin-right:6rpx;line-height:1}.action-pill.danger{color:#b91c1c;border-color:#fecaca}.action-pill.is-static{pointer-events:none;color:#9a3412}.description{font-size:25rpx;line-height:1.6;color:#947a68;margin-top:14rpx;white-space:pre-wrap}.meta{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10rpx;margin-top:20rpx}.meta>view{min-width:0;padding:14rpx 6rpx;background:#fff8f1;border:1rpx solid #f5dfcd;border-radius:12rpx;text-align:center}.meta text{display:block;font-size:21rpx;color:#997e6b;overflow-wrap:anywhere}.meta .meta-value{font-size:23rpx;color:#423128;margin-top:5rpx;font-weight:600}.serving{margin-top:12rpx;font-size:23rpx;color:#9a6c46}.section{padding:24rpx 28rpx 0}.heading{font-size:32rpx;font-weight:700;margin-bottom:16rpx}.empty{font-size:24rpx;color:#af9581}.ingredients{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx}.ingredient{display:flex;align-items:center;gap:12rpx;min-width:0;background:#fff;border:1rpx solid #f4dfcd;border-radius:12rpx;padding:14rpx}.ingredient image,.ingredient-placeholder{width:76rpx;height:76rpx;flex:none;border-radius:8rpx;background:#fff1df}.ingredient-placeholder{display:flex;align-items:center;justify-content:center;color:#e79051}.ingredient-info{display:flex;flex-direction:column;gap:5rpx;min-width:0;font-size:25rpx;overflow-wrap:anywhere}.ingredient-info text:last-child{font-size:22rpx;color:#a08471}.step{display:flex;gap:18rpx;background:#fff;border:1rpx solid #f4dfcd;border-radius:12rpx;padding:20rpx;margin-bottom:14rpx}.step-number{display:flex;align-items:center;justify-content:center;width:50rpx;height:50rpx;flex:none;border-radius:50%;background:#ff7913;color:white;font-weight:700}.step-content{flex:1;min-width:0}.step-title{font-size:27rpx;font-weight:700}.step-description{font-size:25rpx;color:#806a5a;line-height:1.65;white-space:pre-wrap;margin-top:8rpx}.step-content image{display:block;width:100%;margin-top:14rpx;border-radius:8rpx}.tips{font-size:25rpx;color:#806a5a;line-height:1.6}.state{text-align:center;padding:60rpx;color:#9b8270}
