<view class="page register-page">
  <view class="reg-head"><view class="eyebrow">王师傅家生活助手</view><view class="reg-title">注册账号</view><view class="muted">注册后可以创建自己的家庭，或用邀请码加入家人的家庭。</view></view>
  <view class="mode-tabs"><view class="mode-tab {{mode === 'email' ? 'active' : ''}}" data-mode="email" bindtap="switchMode">邮箱注册</view><view class="mode-tab {{mode === 'invite' ? 'active' : ''}}" data-mode="invite" bindtap="switchMode">邀请码注册</view></view>
  <view class="surface reg-form">
    <block wx:if="{{mode === 'email'}}">
      <view class="field"><view class="label">邮箱</view><input value="{{email}}" data-field="email" bindinput="field" maxlength="200" placeholder="用于接收验证码" /></view>
      <view class="field"><view class="label">验证码</view><view class="code-row"><input value="{{code}}" data-field="code" bindinput="field" maxlength="6" placeholder="6 位验证码" /><button class="code-button" loading="{{sending}}" disabled="{{sending || countdown > 0}}" bindtap="sendCode">{{countdown > 0 ? countdown + ' 秒后重发' : '发送验证码'}}</button></view></view>
    </block>
    <block wx:else>
      <view class="field"><view class="label">邀请码</view><view class="code-row"><input value="{{inviteInput}}" data-field="inviteInput" bindinput="field" maxlength="16" placeholder="请输入家人给你的邀请码" /><button class="code-button" loading="{{checking}}" disabled="{{checking}}" bindtap="checkInvite">验证</button></view></view>
      <view wx:if="{{inviteInfo}}" class="invite-card"><view class="invite-house">{{inviteInfo.householdName}}</view><view class="invite-meta">{{inviteInfo.inviterName}} 邀请你以「{{inviteInfo.memberRole === 'admin' ? '管理员' : '成员'}}」身份加入</view></view>
    </block>
    <view class="field"><view class="label">用户名</view><input value="{{username}}" data-field="username" bindinput="field" maxlength="32" placeholder="2-32 位中文、字母、数字、_ 或 -" /></view>
    <view class="field"><view class="label">昵称（选填）</view><input value="{{nickname}}" data-field="nickname" bindinput="field" maxlength="32" placeholder="家人看到的名字" /></view>
    <view class="field"><view class="label">密码</view><input value="{{password}}" data-field="password" bindinput="field" password maxlength="64" placeholder="至少 8 位" /></view>
    <view class="field"><view class="label">确认密码</view><input value="{{confirmPassword}}" data-field="confirmPassword" bindinput="field" password maxlength="64" placeholder="再次输入密码" /></view>
    <view wx:if="{{mode === 'email'}}" class="field"><view class="label">邀请码（选填）</view><input value="{{inviteCode}}" data-field="inviteCode" bindinput="field" maxlength="16" placeholder="有邀请码可直接加入家庭" /></view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="primary submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">注册</button>
    <view class="back-link" bindtap="goLogin">已有账号，返回登录</view>
  </view>
</view>
