@import "../../assets/shell-header.wxss";
.wanted-page{padding-top:0}.page-head{display:flex;align-items:flex-end;justify-content:space-between;padding:24rpx 28rpx;margin-bottom:20rpx;background:#fff;border:1rpx solid #f5ddca;border-radius:16rpx}.page-title{font-size:40rpx;font-weight:700;margin-top:4rpx}.page-count{font-size:24rpx;color:#9b806c}.date-scroll{width:100%;white-space:nowrap;margin-bottom:16rpx}.date-tabs{display:inline-flex;gap:12rpx}.date-tab{padding:12rpx 22rpx;border:1rpx solid #f0dac7;border-radius:30rpx;background:#fff;color:#80634f;font-size:24rpx}.date-tab.active{background:#fff0df;color:#df6410;border-color:#ffceaa}.quick-actions{display:flex;gap:14rpx;margin-bottom:20rpx}.quick-button{flex:1;height:72rpx;border-radius:36rpx;background:#ff7614;color:#fff;font-size:25rpx;font-weight:600;display:flex;align-items:center;justify-content:center;gap:8rpx}.want-list{display:flex;flex-direction:column;gap:14rpx}.want-item{display:flex;align-items:center;gap:16rpx;padding:16rpx;background:#fff;border:1rpx solid #f5dfcd;border-radius:14rpx}.want-cover{width:120rpx;height:96rpx;flex:none;border-radius:10rpx;background:#fff1e4}.want-cover.placeholder{display:flex;align-items:center;justify-content:center;color:#d7a984}.want-info{flex:1;min-width:0}.want-name{font-size:28rpx;font-weight:700;overflow-wrap:anywhere}.want-date{font-size:22rpx;color:#9a7b65;margin-top:8rpx}.want-actions{flex:none;display:flex;flex-direction:column;gap:8rpx;align-items:flex-end}.want-action{padding:8rpx 16rpx;border:1rpx solid #f5ddca;border-radius:24rpx;font-size:22rpx;color:#c2410c;background:#fffaf4}.want-action.danger{color:#b91c1c;border-color:#fecaca}.sheet-layer{position:fixed;inset:0;z-index:600;background:rgba(47,38,31,.32);display:flex;align-items:flex-end;justify-content:center}.sheet{width:100%;max-width:860rpx;box-sizing:border-box;padding:28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));border-radius:24rpx 24rpx 0 0;background:#fffaf2}.sheet-title{font-size:32rpx;font-weight:700;margin-bottom:20rpx}.sheet-row{display:flex;align-items:center;justify-content:space-between;padding:20rpx 0;border-top:1rpx solid #f5e6d8;font-size:27rpx;color:#5c4638}.sheet-value{color:#d9600c;font-weight:600}.sheet-actions{display:flex;gap:16rpx;margin-top:24rpx}.sheet-actions button{flex:1;height:80rpx;border-radius:40rpx;font-size:28rpx;font-weight:600}.sheet-cancel{background:#fff;color:#8b7463;border:1rpx solid #f0dac7}.sheet-submit{background:#ff7614;color:#fff}.notify-preview{padding:20rpx;border-radius:12rpx;background:#fff3e6;color:#7c4a21;font-size:25rpx;line-height:1.6;margin-bottom:20rpx}.notify-members{display:flex;flex-wrap:wrap;gap:12rpx}.member-chip{padding:12rpx 22rpx;border:1rpx solid #f0dac7;border-radius:30rpx;background:#fff;color:#80634f;font-size:24rpx}.member-chip.active{background:#ff7614;border-color:#ff7614;color:#fff}.empty-state{min-height:440rpx;padding:60rpx 24rpx;border-radius:18rpx;background:rgba(255,255,255,.72);border:1rpx dashed #f3c89b;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22rpx;text-align:center}.empty-plate{width:144rpx;height:144rpx;border-radius:50%;background:#ffead7;color:#ff7614;display:flex;align-items:center;justify-content:center}.empty-plate .van-icon{font-size:64rpx;line-height:1}.empty-text{font-size:28rpx;color:#927d6e}.empty-button{margin:0;padding:0 40rpx;height:64rpx;line-height:64rpx;border-radius:32rpx;background:#ff7614;color:#fff;font-size:26rpx;font-weight:600}.state{margin-bottom:12rpx}
