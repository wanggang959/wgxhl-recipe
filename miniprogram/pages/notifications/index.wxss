@import "../../assets/vant-icons.wxss";
.notice-page{padding-top:30rpx}.heading{margin:0 0 24rpx}.heading-title{font-size:44rpx;font-weight:700;color:#30241d;margin-top:4rpx}.heading-sub{font-size:24rpx;color:#927866;margin-top:8rpx}
.toolbar{display:flex;align-items:center;justify-content:space-between;padding:18rpx 22rpx;border-radius:24rpx;margin-bottom:20rpx}.count{color:#806b5b;font-size:25rpx}.mark-all,.retry{display:flex;align-items:center;justify-content:center;width:auto;height:60rpx;line-height:1;margin:0;padding:0 24rpx;border:0;border-radius:32rpx;color:#fff;background:#ff7614;font-size:24rpx}.mark-all[disabled]{color:#a78b77;background:#f8dcc4}.retry{margin:20rpx auto 0}
.toolbar-actions{display:flex;align-items:center;gap:12rpx}.delete-read{display:flex;align-items:center;justify-content:center;gap:6rpx;width:auto;height:60rpx;line-height:1;margin:0;padding:0 18rpx;border:1rpx solid #f4ddca;border-radius:32rpx;background:#fff;color:#a85e2c;font-size:24rpx;white-space:nowrap}.delete-read[disabled]{color:#c5b3a6;background:#faf7f3}
.notice-list{display:flex;flex-direction:column;gap:20rpx}.notice{display:flex;gap:20rpx;padding:24rpx;border-radius:28rpx;box-shadow:0 10rpx 24rpx rgba(154,52,18,.06)}.notice.unread{border-color:#ffc997;background:#fff8ed}.notice-icon{display:flex;align-items:center;justify-content:center;width:68rpx;height:68rpx;flex:none;border-radius:22rpx;background:#fff1e1;color:#f47716;font-size:34rpx}.unread .notice-icon{background:#ff7614;color:#fff}.notice-body{min-width:0;flex:1}.notice-title-row{display:flex;align-items:center;gap:12rpx}.notice-title{flex:1;min-width:0;font-size:30rpx;font-weight:700;color:#30241d;word-break:break-all}.unread-tag{flex:none;color:#fff;background:#ff7614;border-radius:24rpx;padding:4rpx 12rpx;font-size:21rpx}.notice-content{font-size:26rpx;line-height:1.55;color:#6f5a49;margin-top:10rpx;word-break:break-all}.notice-time{font-size:23rpx;color:#927866;margin-top:10rpx}.notice-actions{display:flex;gap:12rpx;margin-top:16rpx}.notice-actions button{display:inline-flex;align-items:center;justify-content:center;width:auto;height:52rpx;line-height:1;margin:0;padding:0 18rpx;border:1rpx solid #f4ddca;border-radius:28rpx;background:#fff;color:#c75d14;font-size:23rpx}.notice-actions .remove{color:#c74c45}.more{text-align:center;color:#a18b79;font-size:23rpx;padding:16rpx}

