<view class="admin-page"><view class="header"><view class="eyebrow">王师傅家</view><view class="title">系统管理</view></view><view wx:if="{{error && !authorized}}" class="state" bindtap="retry">{{error}}，点击重试</view><block wx:elif="{{authorized}}"><view class="tabs"><view class="tab {{tab==='summary'?'active':''}}" data-tab="summary" bindtap="switchTab">系统概览</view><view class="tab {{tab==='users'?'active':''}}" data-tab="users" bindtap="switchTab">用户管理</view></view><view wx:if="{{error}}" class="error" bindtap="retry">{{error}}，点击重试</view><block wx:if="{{tab==='summary'}}"><view class="section-head"><text>运行情况</text><text class="refresh" bindtap="loadSummary">刷新</text></view><view wx:if="{{summary}}" class="stats"><view><text>账号总数</text><text>{{summary.users}}</text></view><view><text>家庭总数</text><text>{{summary.households}}</text></view><view><text>菜谱总数</text><text>{{summary.recipes}}</text></view><view><text>未完成待办</text><text>{{summary.todos}}</text></view></view></block><block wx:else><view class="section-head"><text>用户管理</text><text class="count">{{total}} 人</text></view><view class="search"><input value="{{keyword}}" bindinput="inputKeyword" bindconfirm="search" confirm-type="search" placeholder="搜索用户名、昵称或邮箱" maxlength="100"/><view bindtap="search">搜索</view></view><view wx:for="{{users}}" wx:key="id" class="user-row"><view class="user-main"><view class="name">{{item.nickname || item.username}}</view><view class="muted">用户名：{{item.username}}</view><view class="muted">邮箱：{{item.email || '未填写'}}</view><view class="muted">家庭：{{item.households || '暂无'}}</view><view class="muted">注册：{{item.createLabel || '暂无'}}</view></view><view class="user-actions"><text class="status {{item.status==='normal'?'normal':'stopped'}}">{{item.status==='normal'?'正常':'已停用'}}</text><view wx:if="{{item.canChange}}" class="action" data-id="{{item.id}}" bindtap="changeStatus">{{item.status==='normal'?'停用':'恢复'}}</view><text wx:else class="muted">当前账号</text></view></view><view wx:if="{{!loading && !error && !users.length}}" class="state">没有找到用户</view><view wx:elif="{{!loading && users.length>=total && users.length}}" class="state">已显示全部</view></block></block><view wx:if="{{loading}}" class="state">正在加载...</view></view>
