@import "../../assets/vant-icons.wxss";
.home-page{padding-top:20rpx;padding-bottom:40rpx}.app-header{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;margin:-20rpx -28rpx 20rpx;padding:20rpx 28rpx;background:#fff9f2;border-bottom:1rpx solid #f5e6d8}.app-name{font-size:30rpx;font-weight:700;line-height:1.2}.header-actions{display:flex;align-items:center;gap:12rpx}.bell-button,.header-add{position:relative;display:flex;align-items:center;justify-content:center;width:68rpx;height:68rpx;border:1rpx solid #f5ddca;border-radius:50%;background:#fff;color:#ff7614;font-size:34rpx;box-sizing:border-box}.header-add{background:#ff7614;color:white;font-size:40rpx}.bell-badge{position:absolute;top:-5rpx;right:-5rpx;min-width:28rpx;height:28rpx;padding:0 4rpx;border-radius:20rpx;background:#e63d37;color:white;font-size:19rpx;line-height:28rpx;text-align:center}.hero{display:flex;flex-direction:column;gap:10rpx;padding:28rpx;background:#fff0df;border:1rpx solid #f5dfcb;border-radius:16rpx;margin-bottom:20rpx}.hero-kicker{font-size:23rpx;color:#dd6b20}.hero-title{font-size:37rpx;font-weight:700;color:#392d26;overflow-wrap:anywhere}.hero-copy{font-size:24rpx;color:#967965}.switches{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:18rpx}.segmented{display:flex;border:1rpx solid #f2dfd0;border-radius:32rpx;background:#fff;padding:4rpx;flex:none}.segment{padding:8rpx 14rpx;border-radius:28rpx;font-size:22rpx;color:#8b7463;white-space:nowrap}.segment.active{background:#fff0e1;color:#ea6d0d}.sort .segment.active{background:#f1f2f4;color:#333}.guest-label{font-size:24rpx;color:#9c7358}.search{display:flex;align-items:center;gap:14rpx;background:#fff;border:1rpx solid #f2dfd0;border-radius:40rpx;padding:8rpx 10rpx 8rpx 20rpx;margin-bottom:18rpx;color:#f47716}.search input{flex:1;min-width:0;font-size:26rpx;color:#382e29}.search-button{padding:12rpx 24rpx;border-radius:32rpx;background:#fff0df;font-size:24rpx}.category-scroll{width:100%;white-space:nowrap}.category-list{display:inline-flex;gap:12rpx}.category{padding:12rpx 20rpx;border:1rpx solid #f0dac7;border-radius:30rpx;background:white;color:#80634f;font-size:24rpx}.category.active{background:#fff0df;color:#df6410;border-color:#ffceaa}.inline-error{font-size:22rpx;color:#b45139;padding:12rpx}.list-header{display:flex;justify-content:space-between;align-items:center;margin:28rpx 0 18rpx;font-size:32rpx;font-weight:700}.list-header text:last-child{font-size:23rpx;font-weight:400;color:#9b806c}.recipe-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}.recipe-card{overflow:hidden;border:1rpx solid #f1dfcf;border-radius:16rpx;background:#fff}.cover{display:block;width:100%;height:240rpx;background:#fff1e4}.placeholder{display:flex;align-items:center;justify-content:center;color:#d7a984;font-size:52rpx}.recipe-body{padding:18rpx}.recipe-title{font-size:29rpx;font-weight:700;line-height:1.4;overflow-wrap:anywhere}.recipe-meta,.recipe-owner{font-size:22rpx;color:#957a67;line-height:1.5;margin-top:8rpx;overflow-wrap:anywhere}.recipe-owner{color:#c66320}.state{text-align:center;color:#9b8270;font-size:24rpx;padding:40rpx 10rpx}
