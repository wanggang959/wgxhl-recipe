.detail-page{padding-top:28rpx}.page-title{font-size:42rpx;font-weight:700;margin:6rpx 0 24rpx}.detail-card{padding:28rpx;border-radius:28rpx;box-shadow:0 12rpx 26rpx rgba(154,52,18,.07)}.title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.title{font-size:34rpx;margin:0;min-width:0;word-break:break-all}.tag{flex:none;background:#fff0dd;color:#c75d14;font-size:23rpx;padding:6rpx 16rpx;border-radius:24rpx}.details{margin-top:22rpx}.row{display:flex;gap:22rpx;padding:15rpx 0;border-bottom:1rpx solid #f9eee5;font-size:25rpx;line-height:1.5}.label{flex:none;width:110rpx;color:#9a806e}.value{flex:1;min-width:0;color:#4b3b30;word-break:break-all}.edit,.retry{display:flex;align-items:center;justify-content:center;width:100%;height:70rpx;line-height:1;margin:26rpx 0 0;border:0;border-radius:36rpx;background:#ff7614;color:#fff;font-size:27rpx}.retry{width:180rpx;margin:20rpx auto 0}
.refresh-error{padding:14rpx 18rpx;margin-bottom:14rpx;color:#a85826;background:#fff1df;border-radius:12rpx;font-size:23rpx}
