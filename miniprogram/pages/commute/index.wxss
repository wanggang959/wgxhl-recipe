.commute-page{padding-top:26rpx}.page-title{font-size:40rpx;font-weight:700;margin:8rpx 0 20rpx}.tabs{display:flex;gap:10rpx;margin:12rpx 0 22rpx}.tab{padding:12rpx 24rpx;border-radius:26rpx;color:#805f48;background:#fff;border:1rpx solid #f3dbc8;font-size:25rpx}.tab.active{background:#ff7614;border-color:#ff7614;color:#fff}.section{padding:26rpx;margin-bottom:20rpx;border-radius:26rpx}.section-title{font-size:29rpx;font-weight:700}.line{font-size:25rpx;line-height:1.6;margin-top:10rpx;word-break:break-all}.hint{font-size:22rpx;color:#98816e;line-height:1.5;margin-top:8rpx;word-break:break-all}.text-action{display:inline-flex;margin-top:16rpx;color:#d56b1c;font-size:24rpx}.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10rpx;margin-top:12rpx}.stats>view{padding:12rpx;background:#fff8ef;border-radius:16rpx}.stat-value{font-size:24rpx;font-weight:700;margin-top:8rpx}.list-heading,.record-head,.record-actions,.channel{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.list-heading{margin:24rpx 0 16rpx}.add{padding:10rpx 20rpx;border-radius:28rpx;color:#fff;background:#ff7614;font-size:24rpx}.record-head{font-size:26rpx;font-weight:700}.record-actions{justify-content:flex-end}.record-actions .hint{margin-right:auto}.danger{color:#c84646;font-size:24rpx;margin-top:16rpx}.empty{padding:36rpx;text-align:center;color:#9b8472;font-size:24rpx}.form .field{min-width:0;margin:18rpx 0}.label{font-size:23rpx;color:#80634f;margin-bottom:8rpx}.form input,.form textarea,.picker{box-sizing:border-box;width:100%;min-height:70rpx;line-height:70rpx;padding:0 16rpx;border:1rpx solid #f4d9c3;border-radius:16rpx;background:#fff;font-size:25rpx}.form textarea{height:110rpx;line-height:1.5;padding:12rpx 16rpx}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx}.channel{padding:12rpx 0;font-size:24rpx}.channel switch{transform:scale(.8);transform-origin:right center}.primary{width:100%;height:74rpx;line-height:74rpx;padding:0;margin:20rpx 0 0;border-radius:18rpx;background:#ff7614;color:#fff;font-size:26rpx}.center{display:block;text-align:center}.error{padding:18rpx;margin-bottom:18rpx;border:1rpx solid #f3caca;border-radius:16rpx;background:#fff2f2;color:#b94040;font-size:24rpx}.location-result{padding:14rpx 0;border-bottom:1rpx solid #f7ece1;color:#795b45;font-size:24rpx}
