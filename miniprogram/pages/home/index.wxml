<view class="page home-page">
  <view class="app-header"><view><view class="eyebrow">{{user.householdName || '王师傅家'}}</view><view class="app-name">家庭生活助手</view></view><view class="header-actions"><view class="bell-button" role="button" aria-label="打开通知" bindtap="openNotifications"><text class="van-icon van-icon-bell"></text><text wx:if="{{unread}}" class="bell-badge">{{unread > 99 ? '99+' : unread}}</text></view><view class="header-add" role="button" aria-label="新增待办" bindtap="add">＋</view></view></view>
  <view class="hero"><text class="hero-kicker">欢迎回家</text><text class="hero-title">{{user.householdName || '王师傅家'}}的生活日常</text><text class="hero-copy">记录家里的味道，也照管家里的小事。</text></view>
  <view class="switches"><view wx:if="{{!guest}}" class="segmented"><view class="segment {{scope==='family'?'active':''}}" data-value="family" bindtap="chooseScope">家庭</view><view class="segment {{scope==='public'?'active':''}}" data-value="public" bindtap="chooseScope">公共</view></view><view wx:else class="guest-label">公共菜谱</view><view class="segmented sort"><view wx:for="{{sorts}}" wx:key="value" class="segment {{sort===item.value?'active':''}}" data-value="{{item.value}}" bindtap="chooseSort">{{item.label}}</view></view></view>
  <view class="search"><text class="van-icon van-icon-search"></text><input value="{{keyword}}" bindinput="inputKeyword" bindconfirm="search" confirm-type="search" placeholder="{{scope==='public'?'搜索菜名':'搜索菜名、作者用户名'}}"/><view bindtap="search" class="search-button">搜索</view></view>
  <scroll-view scroll-x class="category-scroll" show-scrollbar="{{false}}"><view class="category-list"><view class="category {{!categoryId?'active':''}}" data-id="" bindtap="chooseCategory">全部</view><view wx:for="{{categories}}" wx:key="id" class="category {{categoryId===item.id?'active':''}}" data-id="{{item.id}}" bindtap="chooseCategory">{{item.categoryName}}</view></view></scroll-view><view wx:if="{{categoryError}}" class="inline-error" bindtap="retryCategories">分类加载失败，点击重试</view>
  <view class="list-header"><text>菜单</text><text>{{total}} 道菜</text></view>
  <view wx:if="{{recipes.length}}" class="recipe-grid"><view wx:for="{{recipes}}" wx:key="id" class="recipe-card" data-id="{{item.id}}" bindtap="openRecipe"><image wx:if="{{item.coverUrl}}" class="cover" src="{{item.coverUrl}}" mode="aspectFill" lazy-load/><view wx:else class="cover placeholder"><text class="van-icon van-icon-photo-o"></text></view><view class="recipe-body"><view class="recipe-title">{{item.recipeName}}</view><view class="recipe-meta">{{item.categoryLabel}} · {{item.tasteLabel}}</view><view class="recipe-meta">{{item.timeLabel}} · {{item.difficultyLabel}}</view><view wx:if="{{item.ownerName}}" class="recipe-owner">{{item.ownerName}}</view></view></view></view>
  <view wx:if="{{loading}}" class="state">正在加载...</view><view wx:elif="{{error}}" class="state" bindtap="retry">{{error}}，点击重试</view><view wx:elif="{{!recipes.length}}" class="state">还没有符合条件的菜谱</view><view wx:elif="{{recipes.length>=total}}" class="state">已显示全部</view>
</view><notice-panel visible="{{noticeOpen}}" bind:close="closeNotifications" bind:change="refreshUnread" />
