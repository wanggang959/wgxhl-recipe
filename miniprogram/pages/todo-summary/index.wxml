<view class="page summary-page">
  <view class="page-head">
    <view class="back-button" role="button" aria-label="返回" bindtap="goBack"><text class="van-icon van-icon-arrow-left"></text></view>
    <view class="head-copy"><view class="eyebrow">做饭安排</view><view class="page-title">采购汇总</view></view>
    <view wx:if="{{!guest}}" class="add-todo-btn" role="button" aria-label="添加采购待办" bindtap="openPurchasePreview"><text class="van-icon van-icon-plus"></text> 待办</view>
  </view>

  <view wx:if="{{guest}}" class="surface state">游客无法查看家庭采购汇总。</view>
  <block wx:else>
    <scroll-view scroll-x class="range-scroll" show-scrollbar="{{false}}"><view class="range-tabs"><view wx:for="{{rangeOptions}}" wx:key="key" class="range-tab {{activeRange===item.key?'active':''}}" data-range="{{item.key}}" bindtap="changeRange">{{item.label}}</view></view></scroll-view>

    <view wx:if="{{loading}}" class="state">汇总中...</view>
    <view wx:elif="{{error}}" class="surface state" bindtap="load">{{error}}，点击重试</view>
    <view wx:elif="{{!wantedCount}}" class="empty-state"><view class="empty-plate"><text class="van-icon van-icon-shop-o"></text></view><view class="empty-text">这个时间范围里还没有待办菜</view><button class="empty-button" bindtap="goTodos">返回待办</button></view>
    <block wx:else>
      <view class="summary-section">
        <view class="section-title">食材</view>
        <view wx:if="{{!ingredients.length}}" class="simple-empty">暂无食材</view>
        <view wx:for="{{ingredients}}" wx:key="key" class="swipe-row">
          <view class="swipe-actions"><view class="swipe-action enough" role="button" data-type="ingredients" data-index="{{index}}" catchtap="markEnough">已够</view><view class="swipe-action buy" role="button" data-type="ingredients" data-index="{{index}}" catchtap="markBuy">待购</view><view class="swipe-action clear" role="button" data-type="ingredients" data-index="{{index}}" catchtap="markClear">清除</view></view>
          <view class="summary-item {{item.statusClass}}" style="transform:translateX({{item.offset || 0}}px)" data-type="ingredients" data-index="{{index}}" bindtouchstart="swipeStart" bindtouchmove="swipeMove" bindtouchend="swipeEnd" bindtap="closeSwipes">
            <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"/><view wx:else class="item-placeholder"><text class="van-icon van-icon-photo-o"></text></view>
            <view class="item-main"><text class="item-name">{{item.name}}</text><text class="item-amount">{{item.amount}}</text><text wx:if="{{item.statusText}}" class="item-status">{{item.statusText}}</text></view>
          </view>
        </view>
      </view>

      <view class="summary-section">
        <view class="section-title">调料</view>
        <view wx:if="{{!seasonings.length}}" class="simple-empty">暂无调料</view>
        <view wx:else class="seasoning-list">
          <view wx:for="{{seasonings}}" wx:key="key" class="swipe-row seasoning-swipe">
            <view class="swipe-actions"><view class="swipe-action enough" role="button" data-type="seasonings" data-index="{{index}}" catchtap="markEnough">已够</view><view class="swipe-action buy" role="button" data-type="seasonings" data-index="{{index}}" catchtap="markBuy">待购</view><view class="swipe-action clear" role="button" data-type="seasonings" data-index="{{index}}" catchtap="markClear">清除</view></view>
            <view class="seasoning-item {{item.statusClass}}" style="transform:translateX({{item.offset || 0}}px)" data-type="seasonings" data-index="{{index}}" bindtouchstart="swipeStart" bindtouchmove="swipeMove" bindtouchend="swipeEnd" bindtap="closeSwipes">
              <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"/><view wx:else class="item-placeholder"><text class="van-icon van-icon-photo-o"></text></view>
              <view class="item-main"><text class="item-name">{{item.name}}</text><text wx:if="{{item.statusText}}" class="item-status">{{item.statusText}}</text></view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </block>
</view>

<view wx:if="{{buyEditorOpen}}" class="sheet-layer" bindtap="closeBuyEditor">
  <view class="sheet buy-sheet" catchtap="swallow">
    <view class="sheet-title">{{buyTarget.name || '待购数量'}}</view>
    <view class="sheet-field"><view class="sheet-label">待购数量</view><input value="{{buyQuantity}}" bindinput="inputBuyQuantity" placeholder="比如：2袋、500克、1瓶" /></view>
    <view class="buy-actions"><button class="buy-save" bindtap="submitBuyEditor">保存</button><button class="buy-cancel" bindtap="closeBuyEditor">取消</button></view>
  </view>
</view>

<view wx:if="{{previewOpen}}" class="sheet-layer" bindtap="closePurchasePreview">
  <view class="sheet preview-sheet" catchtap="swallow">
    <view class="preview-eyebrow">采购任务预览</view>
    <view class="preview-count">{{previewLines.length}} 项待购</view>
    <scroll-view scroll-y class="preview-list"><view wx:for="{{previewLines}}" wx:key="*this" class="preview-line">{{item}}</view></scroll-view>
    <view class="preview-actions"><button class="preview-cancel" bindtap="closePurchasePreview">取消</button><button class="preview-submit" loading="{{previewBusy}}" disabled="{{previewBusy}}" bindtap="confirmPurchaseTodo">{{previewBusy ? '加入中...' : '确定加入'}}</button></view>
  </view>
</view>
