.reset-page{padding-top:44rpx}.title{font-size:38rpx;font-weight:700;margin-bottom:26rpx}.panel{padding:28rpx;background:#fff;border:1rpx solid #f3dfd0;border-radius:14rpx}.heading{font-size:31rpx;font-weight:700}.label{font-size:25rpx;color:#765d4b;margin-bottom:10rpx}.label.space{margin-top:22rpx}input,textarea{box-sizing:border-box;width:100%;padding:0 18rpx;border:1rpx solid #efd8c5;border-radius:10rpx;background:#fffaf5;font-size:27rpx}input{height:80rpx}textarea{height:150rpx;padding:16rpx 18rpx}.note{font-size:23rpx;color:#927d6e;line-height:1.7;margin:20rpx 0}.error{color:#c43630;font-size:24rpx;margin:18rpx 0}.primary-action,.secondary-action{display:flex;align-items:center;justify-content:center;min-height:80rpx;border-radius:12rpx;font-size:27rpx}.primary-action{margin-top:22rpx;background:#ff7614;color:#fff;font-weight:600}.secondary-action{margin-top:12rpx;color:#d36a1d}.disabled{opacity:.55}.back{text-align:center;margin-top:26rpx;font-size:25rpx;color:#987a64}
