.mask{position:fixed;top:0;right:0;bottom:0;left:0;z-index:1000;background:rgba(0,0,0,.45);display:flex;align-items:flex-end}.sheet{box-sizing:border-box;width:100%;max-height:85vh;overflow:auto;background:#fffaf5;border-radius:18rpx 18rpx 0 0;padding:28rpx 32rpx calc(30rpx + env(safe-area-inset-bottom));color:#382d27}.header{display:flex;align-items:center;justify-content:space-between}.title{font-size:32rpx;font-weight:700}.close{font-size:42rpx;color:#987f70;padding:0 10rpx}.details{margin-top:20rpx;padding:22rpx;background:#fff0df;border-radius:10rpx}.name{font-size:29rpx;font-weight:700}.muted{font-size:23rpx;color:#987f70;margin-top:10rpx}.label{font-size:25rpx;color:#8d705d;margin:24rpx 0 10rpx}.input{box-sizing:border-box;width:100%;background:#fff;border:1rpx solid #ead9cd;border-radius:8rpx;padding:18rpx;font-size:27rpx;min-height:78rpx}.primary,.secondary{margin-top:22rpx;font-size:27rpx;border-radius:10rpx}.primary{background:#f77716;color:#fff}.secondary{background:#fff0df;color:#9d5a2e}.error{color:#b94c40;font-size:24rpx;margin-top:16rpx}
