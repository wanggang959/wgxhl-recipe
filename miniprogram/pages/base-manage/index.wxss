page{background:#fff9f2;color:#342a24;font-size:26rpx}.page{padding:24rpx 26rpx 48rpx}.hint{font-size:23rpx;line-height:1.6;color:#9a7962;margin-bottom:20rpx}.tabs{display:flex;background:#fff;border:1rpx solid #f3dfcf;border-radius:14rpx;overflow:hidden}.tab{flex:1;text-align:center;padding:21rpx 0;color:#826a58}.tab.active{color:#f47716;font-weight:600;border-bottom:4rpx solid #f47716}.bar{display:flex;align-items:center;justify-content:space-between;margin:28rpx 0 20rpx}.title{font-size:32rpx;font-weight:700}.add,.save{background:#ff7913;color:#fff;border-radius:30rpx;padding:14rpx 24rpx;font-size:24rpx}.search{display:flex;align-items:center;gap:20rpx;background:#fff;border:1rpx solid #f3dfcf;border-radius:16rpx;padding:15rpx 20rpx;margin-bottom:18rpx;color:#ec7318}.search input{flex:1;min-width:0;color:#342a24}.item{display:flex;align-items:center;gap:16rpx;background:#fff;border:1rpx solid #f4ddca;border-radius:16rpx;padding:20rpx;margin-bottom:14rpx}.thumb{width:88rpx;height:88rpx;flex:none;border-radius:12rpx;background:#fff3e7}.placeholder{display:flex;align-items:center;justify-content:center;color:#d9b49d}.info{min-width:0;flex:1}.item-title{display:flex;align-items:center;gap:10rpx;font-weight:600;overflow-wrap:anywhere}.scope{flex:none;color:#e86e10;background:#fff0e0;border-radius:20rpx;padding:4rpx 10rpx;font-size:20rpx}.scope.public{color:#457994;background:#e9f4fa}.detail{color:#9b8270;font-size:23rpx;line-height:1.5;margin-top:9rpx;overflow-wrap:anywhere}.actions{display:flex;flex-direction:column;gap:14rpx;color:#e9741a;font-size:23rpx;flex:none}.danger,.error{color:#d64335}.state{text-align:center;padding:32rpx;color:#9b8270;font-size:24rpx}.overlay{position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.52);display:flex;align-items:flex-end}.sheet{box-sizing:border-box;width:100%;max-height:88vh;background:#fffdfb;border-radius:24rpx 24rpx 0 0;padding:28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom))}.sheet-head{display:flex;justify-content:space-between;align-items:center;font-size:32rpx;font-weight:700;margin-bottom:20rpx}.close{font-size:44rpx;color:#9b8270}.form-scroll{max-height:62vh}.field{margin-bottom:20rpx;color:#745d4c;font-size:24rpx}.field>text{display:block;margin-bottom:9rpx}.field input,.field textarea{box-sizing:border-box;width:100%;background:#fff9f5;border:1rpx solid #f1d8c5;border-radius:10rpx;padding:15rpx 18rpx;color:#342a24}.field textarea{height:125rpx}.image-row{display:flex;align-items:center;gap:18rpx}.preview{width:100rpx;height:100rpx;border-radius:10rpx}.image-add{padding:18rpx;border:1rpx dashed #e9b996;border-radius:10rpx;color:#e8751a}.error{font-size:23rpx;margin:12rpx 0}.form-actions{display:flex;gap:16rpx;margin-top:18rpx;text-align:center}.cancel,.save{box-sizing:border-box;flex:1;padding:18rpx;border-radius:12rpx}.cancel{border:1rpx solid #edcfb8;color:#80624c}.save{font-size:26rpx}
