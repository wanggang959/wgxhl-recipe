<view class="page commute-page">
  <view class="eyebrow">我的日常</view><view class="page-title">通勤记录</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <block wx:if="{{authorized}}">
  <view class="tabs"><view class="tab {{tab === 'records' ? 'active' : ''}}" data-value="records" bindtap="tab">记录</view><view class="tab {{tab === 'settings' ? 'active' : ''}}" data-value="settings" bindtap="tab">设置</view></view>
  <block wx:if="{{!editor}}">
    <block wx:if="{{tab === 'records'}}">
      <view wx:if="{{recommendation.configured}}" class="surface section"><view class="section-title">{{recommendation.date}} · {{recommendation.workDay ? '出门建议' : '非设定上班日 · 参考建议'}}</view><view wx:if="{{recommendation.dry}}" class="line">不下雨：{{recommendation.dryLabel}} 前出门 · {{recommendation.dry.source === 'FALLBACK' ? '记录不足，按预计时长' : recommendation.dry.sampleCount + ' 条记录'}}</view><view wx:if="{{recommendation.rain}}" class="line">下雨：{{recommendation.rainLabel}} 前出门 · {{recommendation.rain.source === 'FALLBACK' ? '记录不足，按预计时长' : recommendation.rain.sampleCount + ' 条记录'}}</view><view wx:if="{{recommendation.departureLabel}}" class="line">{{recommendation.departureLabel}} 前出门</view><view class="hint">已含预留 {{recommendation.bufferMinutes}} 分钟</view><view wx:if="{{recommendation.weatherSummary}}" class="hint">{{recommendation.weatherSummary}}</view><view class="hint">天气来源：和风天气 · 预报仅供参考</view><view class="text-action" bindtap="pause">暂停本次通知</view></view>
      <view wx:else class="surface section"><view class="section-title">还没有通勤设置</view><view class="text-action" data-value="settings" bindtap="tab">设置通勤</view></view>
      <view class="surface section"><view class="section-title">近30天通勤</view><view wx:if="{{statistics}}" class="stats"><view><view class="hint">全部</view><view class="stat-value">{{statistics.allAverage === null ? '—' : statistics.allAverage}} 分钟</view><view class="hint">{{statistics.allCount}} 条</view></view><view><view class="hint">下雨</view><view class="stat-value">{{statistics.rainAverage === null ? '—' : statistics.rainAverage}} 分钟</view><view class="hint">{{statistics.rainCount}} 条</view></view><view><view class="hint">不下雨</view><view class="stat-value">{{statistics.dryAverage === null ? '—' : statistics.dryAverage}} 分钟</view><view class="hint">{{statistics.dryCount}} 条</view></view></view><view wx:else class="hint">统计暂不可用</view></view>
      <view class="list-heading"><view class="section-title">我的记录</view><view class="add" bindtap="edit">＋ 记录</view></view>
      <view wx:if="{{!records.length && !loading}}" class="surface empty">暂无通勤记录</view>
      <view wx:for="{{records}}" wx:key="id" class="surface section record"><view class="record-head"><text>{{item.dateLabel}} · {{item.direction === 'OUTBOUND' ? '上班' : '下班'}}</text><text>{{item.durationMinutes ? item.durationMinutes + ' 分钟' : '待填写'}}</text></view><view wx:if="{{item.departureLabel}}" class="hint">{{item.departureLabel}} → {{item.arrivalLabel}}</view><view wx:if="{{item.durationMinutes}}" class="hint">实际天气：{{item.rainLabel}}</view><view wx:if="{{item.weatherSummary}}" class="hint">天气预报：{{item.weatherSummary}}</view><view wx:if="{{item.remark}}" class="hint">{{item.remark}}</view><view class="record-actions"><text class="hint">{{item.transport}}</text><view class="text-action" data-id="{{item.id}}" bindtap="edit">编辑</view><view class="danger" data-id="{{item.id}}" bindtap="remove">删除</view></view></view>
      <view wx:if="{{loading}}" class="empty">正在加载</view><view wx:elif="{{more && records.length}}" class="empty">继续上滑加载</view>
    </block>
    <view wx:else class="surface section form">
      <block wx:if="{{settingsLoaded}}">
        <view class="field"><view class="label">期望到达时间</view><picker mode="time" value="{{settings.arrivalTime}}" data-field="arrivalTime" bindchange="settingTime"><view class="picker">{{settings.arrivalTime}}</view></picker></view>
        <view class="form-grid"><view class="field"><view class="label">提醒日期</view><picker range="{{['当天','头天']}}" value="{{settings.noticeDay}}" bindchange="noticeDay"><view class="picker">{{settings.noticeDay === 1 ? '头天' : '当天'}}</view></picker></view><view class="field"><view class="label">提醒时间</view><picker mode="time" value="{{settings.noticeTime}}" data-field="noticeTime" bindchange="settingTime"><view class="picker">{{settings.noticeTime}}</view></picker></view></view>
        <view class="form-grid"><view class="field"><view class="label">预留分钟</view><input type="number" value="{{settings.bufferMinutes}}" data-field="bufferMinutes" bindinput="settingsInput" /></view><view class="field"><view class="label">初始预计分钟</view><input type="number" value="{{settings.fallbackMinutes}}" data-field="fallbackMinutes" bindinput="settingsInput" /></view></view>
        <view class="field"><view class="label">上班日</view><picker range="{{workLabels}}" bindchange="workDays"><view class="picker">{{settings.workDays === '1,2,3,4,5,6' ? '周一至周六' : settings.workDays === '1,2,3,4,5,6,7' ? '每天' : '周一至周五'}}</view></picker></view>
        <view class="field"><view class="label">地点</view><view class="tabs"><view class="tab {{locationPrefix === 'origin' ? 'active' : ''}}" data-value="origin" bindtap="locationPrefix">出发地点</view><view class="tab {{locationPrefix === 'destination' ? 'active' : ''}}" data-value="destination" bindtap="locationPrefix">上班地点</view></view><view class="hint">出发：{{settings.originName || '未设置'}}　到达：{{settings.destinationName || '未设置'}}</view><picker range="{{['区县名称','高德分享链接']}}" bindchange="locationMode"><view class="picker">{{locationMode === 'city' ? '区县名称' : '高德分享链接'}}</view></picker><input value="{{locationQuery}}" placeholder="{{locationMode === 'city' ? '例如：双流' : '粘贴高德分享内容'}}" maxlength="2000" bindinput="locationInput" /><view class="text-action" bindtap="search">{{locationBusy ? '查询中' : '查询地点'}}</view><view wx:for="{{locations}}" wx:key="id" class="location-result" data-index="{{index}}" bindtap="selectLocation">{{item.adm1}} · {{item.adm2}} · {{item.name}}</view></view>
        <view class="section-title">通知方式</view><view class="channel"><text>站内通知</text><switch checked="{{settings.siteEnabled}}" color="#ff7614" data-field="siteEnabled" bindchange="channel" /></view><view class="channel"><text>邮箱通知</text><switch checked="{{settings.emailEnabled}}" color="#ff7614" data-field="emailEnabled" bindchange="channel" /></view><view class="channel"><text>App 通知（网页）</text><switch checked="{{settings.pushEnabled}}" color="#ff7614" data-field="pushEnabled" bindchange="channel" /></view>
        <button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="saveSettings">保存设置</button>
      </block><view wx:else class="empty" bindtap="initialize">设置加载失败，点击重试</view>
    </view>
  </block>
  <view wx:else class="surface section form">
    <view class="section-title">{{form.id ? '编辑记录' : '记录通勤'}}</view>
    <view class="field"><view class="label">日期</view><picker mode="date" value="{{form.commuteDate}}" end="{{today}}" bindchange="date"><view class="picker">{{form.commuteDate}}</view></picker></view>
    <view class="field"><view class="label">方向</view><picker range="{{['上班','下班']}}" value="{{form.direction === 'OUTBOUND' ? 0 : 1}}" bindchange="direction"><view class="picker">{{form.direction === 'OUTBOUND' ? '上班' : '下班'}}</view></picker></view>
    <view class="form-grid"><view class="field"><view class="label">出发时间</view><picker mode="time" value="{{form.departureTime}}" data-field="departureTime" bindchange="time"><view class="picker">{{form.departureTime || '选择时间'}}</view></picker></view><view class="field"><view class="label">到达时间</view><picker mode="time" value="{{form.arrivalTime}}" data-field="arrivalTime" bindchange="time"><view class="picker">{{form.arrivalTime || '选择时间'}}</view></picker></view></view>
    <view class="field"><view class="label">交通方式</view><picker range="{{transports}}" bindchange="transport"><view class="picker">{{form.transport}}</view></picker></view>
    <view class="field"><view class="label">通勤途中是否下雨</view><picker range="{{rainLabels}}" bindchange="rain"><view class="picker">{{form.actualRain === 'RAIN' ? '下雨了' : form.actualRain === 'UNKNOWN' ? '不确定' : '没下雨'}}</view></picker></view>
    <view class="field"><view class="label">备注</view><textarea value="{{form.remark}}" maxlength="500" data-field="remark" bindinput="input" /></view><view class="channel"><text>参与通勤推荐统计</text><switch checked="{{form.includeStats}}" color="#ff7614" bindchange="include" /></view>
    <button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="saveRecord">保存记录</button><view class="text-action center" bindtap="closeEditor">取消</view>
  </view>
  </block>
</view>
