<view class="page expense-page">
  <view class="eyebrow">家庭专项</view><view class="page-title">{{view === 'project' ? (projectForm.id ? '编辑专项' : '新建专项') : view === 'item' ? (itemForm.id ? '编辑开支' : '新增开支') : '专项开支'}}</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <block wx:if="{{view === 'list'}}">
    <view class="bar"><view class="section-title">我的专项</view><view class="text-action" bindtap="toggleArchived">{{showArchived ? '隐藏已归档' : '显示已归档'}}</view><view wx:if="{{canWrite}}" class="add" bindtap="projectEdit">＋ 专项</view></view>
    <scroll-view scroll-x show-scrollbar="{{false}}" class="project-scroll"><view class="project-list"><view wx:for="{{projects}}" wx:key="id" class="project-chip {{selectedId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseProject"><view class="project-name">{{item.projectName}}</view><view class="hint">{{item.typeLabel}}{{item.archived ? ' · 已归档' : ''}}</view></view></view></scroll-view>
    <view wx:if="{{loading}}" class="empty">正在加载</view>
    <view wx:elif="{{!project}}" class="surface empty">暂无专项开支</view>
    <block wx:else>
      <view class="surface section"><view class="bar"><view><view class="eyebrow">{{project.typeLabel}}</view><view class="section-title">{{project.projectName}}</view></view><view wx:if="{{project.canManage}}" class="actions"><view class="text-action" data-id="{{project.id}}" bindtap="projectEdit">编辑</view><view class="text-action" bindtap="archive">{{project.archived ? '恢复' : '归档'}}</view></view></view><view wx:if="{{summary}}" class="stats"><view><view class="hint">总预算</view><view class="amount">¥{{summary.totalBudget || 0}}</view></view><view><view class="hint">已花费</view><view class="amount">¥{{summary.actualAmount || 0}}</view></view><view><view class="hint">剩余</view><view class="amount">¥{{summary.remainingBudget || 0}}</view></view></view><view wx:if="{{summary}}" class="hint">待处理 {{summary.pendingCount || 0}}　已完成 {{summary.doneCount || 0}}　超预算 {{summary.overBudgetCount || 0}}</view></view>
      <view class="surface section"><view class="filter-row"><text class="filter-label">分类</text><scroll-view scroll-x show-scrollbar="{{false}}" class="filter-scroll"><view class="chips"><view wx:for="{{categories}}" wx:key="value" class="chip {{category === item.value ? 'active' : ''}}" data-kind="category" data-value="{{item.value}}" bindtap="filter">{{item.label}}</view></view></scroll-view></view><view class="filter-row"><text class="filter-label">状态</text><scroll-view scroll-x show-scrollbar="{{false}}" class="filter-scroll"><view class="chips"><view wx:for="{{statuses}}" wx:key="value" class="chip {{status === item.value ? 'active' : ''}}" data-kind="status" data-value="{{item.value}}" bindtap="filter">{{item.label}}</view></view></scroll-view></view></view>
      <view class="bar list-heading"><view class="section-title">开支清单</view><view class="list-actions"><view class="export-action {{exporting?'disabled':''}}" role="button" bindtap="exportImage">{{exporting?'生成中...':'导出图片'}}</view><view wx:if="{{canWrite}}" class="add" bindtap="itemEdit">＋ 新增</view></view></view>
      <view wx:if="{{!items.length && !itemsLoading}}" class="surface empty">暂无开支记录</view>
      <view wx:for="{{items}}" wx:key="id" class="surface section"><view class="bar"><view class="item-title">{{item.itemName}}</view><view class="status {{item.status === 'DONE' ? 'done' : ''}}">{{item.statusLabel}}</view></view><view class="hint">{{item.categoryLabel}}　{{item.quantity}}　负责人：{{item.ownerName || '未指定'}}　付款：{{item.payerName || '未指定'}}</view><view class="bar"><view class="hint">预算 ¥{{item.budgetAmount || 0}}</view><view class="actual">实际 ¥{{item.actualAmount || 0}}</view></view><view wx:if="{{item.purchaseDate}}" class="hint">购买 {{item.purchaseDate}}　{{item.purchaseChannel}}</view><view wx:if="{{item.remark}}" class="hint">{{item.remark}}</view><view wx:if="{{item.canManage}}" class="actions"><view class="text-action" data-id="{{item.id}}" bindtap="itemEdit">编辑</view><view class="danger-text" data-id="{{item.id}}" bindtap="remove">删除</view></view></view>
      <view wx:if="{{itemsLoading}}" class="empty">正在加载</view><view wx:elif="{{items.length < total}}" class="empty">继续上滑加载</view>
    </block>
  </block>
  <view wx:elif="{{view === 'project'}}" class="surface section form">
    <view class="field"><view class="label">专项名称</view><input value="{{projectForm.projectName}}" maxlength="100" placeholder="请输入专项名称" data-field="projectName" bindinput="field" /></view>
    <view class="field"><view class="label">专项类型</view><picker range="{{projectTypes}}" range-key="label" value="{{typesIndex}}" data-kind="type" bindchange="pick"><view class="picker">{{projectTypes[typesIndex].label}}</view></picker></view>
    <view class="field"><view class="label">总预算</view><input type="digit" value="{{projectForm.totalBudget}}" placeholder="0.00" data-field="totalBudget" bindinput="field" /></view>
    <view class="field"><view class="label">开始日期</view><picker mode="date" value="{{projectForm.startDate}}" data-field="startDate" bindchange="field"><view class="picker">{{projectForm.startDate || '选择日期'}}</view></picker></view>
    <view class="field"><view class="label">结束日期</view><picker mode="date" value="{{projectForm.endDate}}" data-field="endDate" bindchange="field"><view class="picker">{{projectForm.endDate || '选择日期'}}</view></picker></view>
    <view class="field"><view class="label">备注</view><textarea value="{{projectForm.remark}}" maxlength="500" data-field="remark" bindinput="field" /></view>
    <button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="save">保存专项</button><view class="cancel" bindtap="cancel">取消</view>
  </view>
  <view wx:else class="surface section form">
    <view class="field"><view class="label">开支名称</view><input value="{{itemForm.itemName}}" maxlength="100" placeholder="请输入开支名称" data-field="itemName" bindinput="field" /></view>
    <view class="field"><view class="label">分类</view><picker range="{{itemCategories}}" range-key="label" value="{{categoryIndex}}" data-kind="category" bindchange="pick"><view class="picker">{{itemCategories[categoryIndex].label}}</view></picker></view>
    <view class="grid"><view class="field"><view class="label">预算金额</view><input type="digit" value="{{itemForm.budgetAmount}}" placeholder="0.00" data-field="budgetAmount" bindinput="field" /></view><view class="field"><view class="label">实际金额</view><input type="digit" value="{{itemForm.actualAmount}}" placeholder="0.00" data-field="actualAmount" bindinput="field" /></view></view>
    <view class="field"><view wx:if="{{itemForm.ledgerLinked && !itemForm.ledgerDeleted}}" class="label">已记入家庭账本</view><view wx:else class="bar"><text class="label">{{itemForm.ledgerDeleted ? '恢复记入家庭账本' : '同时记入家庭账本'}}</text><switch checked="{{itemForm.syncToLedger}}" bindchange="toggleLedger" color="#f5791b" /></view></view>
    <view class="field"><view class="label">数量</view><input value="{{itemForm.quantity}}" maxlength="100" placeholder="例如：2件" data-field="quantity" bindinput="field" /></view>
    <view class="field"><view class="label">状态</view><picker range="{{itemStatuses}}" range-key="label" value="{{statusIndex}}" data-kind="status" bindchange="pick"><view class="picker">{{itemStatuses[statusIndex].label}}</view></picker></view>
    <view class="grid"><view class="field"><view class="label">负责人</view><picker range="{{memberOptions}}" range-key="name" value="{{ownerIndex}}" data-kind="owner" bindchange="pick"><view class="picker">{{memberOptions[ownerIndex].name || '不指定'}}</view></picker></view><view class="field"><view class="label">付款人</view><picker range="{{memberOptions}}" range-key="name" value="{{payerIndex}}" data-kind="payer" bindchange="pick"><view class="picker">{{memberOptions[payerIndex].name || '不指定'}}</view></picker></view></view>
    <view class="field"><view class="label">购买日期</view><picker mode="date" value="{{itemForm.purchaseDate}}" data-field="purchaseDate" bindchange="field"><view class="picker">{{itemForm.purchaseDate || '选择日期'}}</view></picker></view>
    <view class="field"><view class="label">提醒时间</view><view class="grid"><picker mode="date" value="{{plannedDate}}" data-field="plannedDate" bindchange="planned"><view class="picker">{{plannedDate || '选择日期'}}</view></picker><picker mode="time" value="{{plannedClock}}" data-field="plannedClock" bindchange="planned"><view class="picker">{{plannedClock || '选择时间'}}</view></picker></view><view wx:if="{{plannedDate}}" class="text-action" bindtap="clearPlanned">清除</view></view>
    <view class="field"><view class="label">购买渠道</view><input value="{{itemForm.purchaseChannel}}" maxlength="100" data-field="purchaseChannel" bindinput="field" /></view>
    <view class="field"><view class="label">购买链接</view><input value="{{itemForm.purchaseLink}}" maxlength="500" data-field="purchaseLink" bindinput="field" /></view>
    <view class="field"><view class="label">备注</view><textarea value="{{itemForm.remark}}" maxlength="500" data-field="remark" bindinput="field" /></view>
    <button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="save">保存开支</button><view class="cancel" bindtap="cancel">取消</view>
  </view>
</view>
<canvas type="2d" id="expense-export-canvas" class="export-canvas" style="width:720px;height:{{exportCanvasHeight || 1}}px"></canvas>
<view wx:if="{{exportOpen}}" class="export-layer" bindtap="closeExport"><view class="export-sheet" catchtap="swallow"><view class="export-head"><text>清单图片</text><view role="button" aria-label="关闭" bindtap="closeExport">×</view></view><scroll-view scroll-y class="export-preview"><image wx:if="{{exportPath}}" src="{{exportPath}}" mode="widthFix"/></scroll-view><view class="export-buttons"><view class="export-save" bindtap="saveExport">保存图片</view><view class="export-share" bindtap="shareExport">分享</view></view></view></view>
