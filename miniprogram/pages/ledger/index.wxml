<view class="page"><view class="header"><view><view class="eyebrow">家庭生活</view><view class="title">家庭记账</view></view><button wx:if="{{!sourceTodoId}}" class="primary add" bindtap="edit">＋ 记一笔</button></view>
<block wx:if="{{!sourceTodoId}}"><picker mode="date" fields="month" value="{{month}}" bindchange="monthChange"><view class="month">{{month}} ▾</view></picker>
<view class="totals"><view><text>收入</text><text class="total-value">¥{{income}}</text></view><view><text>支出</text><text class="total-value">¥{{expense}}</text></view><view><text>结余</text><text class="total-value">¥{{balance}}</text></view></view>
<view class="heading">支出分类</view><view class="categories"><text wx:for="{{categoryTotals}}" wx:key="category">{{item.category}} ¥{{item.amountLabel}}</text><text wx:if="{{!categoryTotals.length}}">本月暂无支出</text></view>
</block><view class="heading">{{sourceTodoId ? '待办账单' : '账单明细'}} <text>{{total}} 笔</text></view><view class="types"><text class="{{filters.entryType===''?'active':''}}" data-value="" bindtap="typeFilter">全部</text><text class="{{filters.entryType==='EXPENSE'?'active':''}}" data-value="EXPENSE" bindtap="typeFilter">支出</text><text class="{{filters.entryType==='INCOME'?'active':''}}" data-value="INCOME" bindtap="typeFilter">收入</text></view><view class="types filter-row"><picker range="{{filterCategories}}" bindchange="filterCategory"><text>{{filters.category || '全部分类'}} ▾</text></picker><picker range="{{filterMembers}}" range-key="nickname" bindchange="filterMember"><text>{{filterMemberName}} ▾</text></picker></view>
<view wx:if="{{error}}" class="state" bindtap="load">{{error}}，点击重试</view><view wx:elif="{{!items.length&&!loading}}" class="state">{{sourceTodoId ? '暂无关联账单' : '本月暂无账单'}}</view><view wx:for="{{items}}" wx:key="id" class="entry"><view class="content"><view class="entry-title">{{item.description}}</view><view class="muted">{{item.occurredOn}} · {{item.category}} · {{item.payerName}}</view><view wx:if="{{item.sourceCycleLabel}}" class="muted">周期：{{item.sourceCycleLabel}}</view><view wx:if="{{item.remark}}" class="muted">{{item.remark}}</view></view><view class="right"><view>{{item.entryType==='INCOME'?'+':'-'}}¥{{item.amountLabel}}</view><view wx:if="{{item.canManage}}"><text wx:if="{{!item.relatedExpenseId}}" data-id="{{item.id}}" bindtap="edit">编辑</text><text data-id="{{item.id}}" bindtap="remove">删除</text></view><view wx:if="{{item.sourceType}}" class="muted" data-id="{{item.id}}" bindtap="source">查看{{item.sourceType==='TODO'?'待办':item.sourceType==='VEHICLE_FUEL'||item.sourceType==='VEHICLE_EXPENSE'?'车辆':'专项'}}</view></view></view><view wx:if="{{loading}}" class="state">正在加载</view>
<view wx:if="{{showForm}}" class="mask" bindtap="close"><view class="sheet" catchtap="swallow"><view class="heading">{{form.id?'编辑账单':'记一笔'}}<text bindtap="close">关闭</text></view><view class="types"><text class="{{form.entryType==='EXPENSE'?'active':''}}" data-value="EXPENSE" bindtap="setType">支出</text><text class="{{form.entryType==='INCOME'?'active':''}}" data-value="INCOME" bindtap="setType">收入</text></view><view class="label">金额</view><input type="digit" value="{{form.amount}}" data-field="amount" bindinput="field" placeholder="请输入金额" /><view class="label">内容</view><input value="{{form.description}}" data-field="description" bindinput="field" maxlength="200" placeholder="请输入内容" /><view class="label">分类</view><picker range="{{categories}}" bindchange="setCategory"><view class="input">{{form.category}} ▾</view></picker><view class="label">日期</view><picker mode="date" value="{{form.occurredOn}}" data-field="occurredOn" bindchange="field"><view class="input">{{form.occurredOn}}</view></picker><view class="label">付款人</view><picker range="{{members}}" range-key="nickname" bindchange="setPayer"><view class="input">{{form.payerName || '选择家庭成员'}} ▾</view></picker><view class="label">备注</view><input value="{{form.remark}}" data-field="remark" bindinput="field" maxlength="500" /><button class="primary save" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存</button></view></view></view>
