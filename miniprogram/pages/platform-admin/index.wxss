page{background:#f8f7f4;color:#282724}.admin-page{padding:28rpx 28rpx 50rpx}.header{padding-bottom:24rpx}.eyebrow{font-size:24rpx;color:#e87118;font-weight:700}.title{font-size:40rpx;font-weight:700;margin-top:6rpx}.tabs{display:flex;gap:34rpx;border-bottom:1rpx solid #e9e5de}.tab{padding:20rpx 0;font-size:27rpx;color:#716f6a}.tab.active{color:#df6510;font-weight:700;border-bottom:4rpx solid #ef791f}.section-head{display:flex;align-items:center;justify-content:space-between;font-size:32rpx;font-weight:700;margin:30rpx 0 20rpx}.refresh,.count{font-size:24rpx;color:#a16b43;font-weight:400}.stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}.stats view{background:#fff;border:1rpx solid #ede8e1;border-radius:10rpx;padding:24rpx}.stats text{display:block;font-size:23rpx;color:#8b827c}.stats text:last-child{font-size:38rpx;font-weight:700;color:#302e2b;margin-top:10rpx}.search{display:flex;align-items:center;gap:15rpx;padding:10rpx 18rpx;margin-bottom:18rpx;background:#fff;border:1rpx solid #ede8e1;border-radius:10rpx;color:#e87519}.search input{flex:1;min-width:0;height:60rpx;font-size:25rpx;color:#302e2b}.user-row{display:flex;justify-content:space-between;gap:16rpx;padding:22rpx 0;border-bottom:1rpx solid #e9e5de}.user-main{min-width:0;flex:1}.name{font-size:28rpx;font-weight:700;overflow-wrap:anywhere}.muted{font-size:22rpx;color:#8b827c;line-height:1.6;overflow-wrap:anywhere}.user-actions{display:flex;flex-direction:column;align-items:flex-end;gap:18rpx;flex:none}.status{font-size:22rpx;padding:5rpx 10rpx;border-radius:6rpx}.normal{background:#edf7ef;color:#39794a}.stopped{background:#fff0ee;color:#bd4b40}.action{color:#d86c1a;font-size:25rpx}.error{padding:18rpx;background:#fff0ee;color:#a93535;font-size:24rpx}.state{text-align:center;color:#8b827c;font-size:24rpx;padding:32rpx}
