.household-page{padding-top:28rpx}.page-title{font-size:40rpx;font-weight:700;margin:8rpx 0 24rpx}.section{padding:26rpx;margin-bottom:20rpx;border-radius:26rpx}.section-title{font-size:29rpx;font-weight:700;margin-bottom:18rpx}.household-row{display:flex;align-items:center;justify-content:space-between;gap:14rpx;padding:18rpx 0;border-bottom:1rpx solid #f7ece1}.household-name{font-size:27rpx;font-weight:700}.active-label{flex:none;color:#dd6b19;font-size:23rpx}.hint{font-size:22rpx;color:#9b8472;line-height:1.5;margin-top:8rpx}.section input,.picker{box-sizing:border-box;width:100%;height:72rpx;line-height:72rpx;padding:0 18rpx;border:1rpx solid #f4d9c3;border-radius:16rpx;background:#fff;font-size:25rpx}.primary-button,.secondary-button,.danger-button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;height:68rpx;line-height:1;padding:0;margin:18rpx 0 0;border-radius:16rpx;font-size:25rpx}.primary-button{background:#ff7614;color:#fff}.secondary-button{background:#fff8ef;color:#c86924;border:1rpx solid #f5d8bf}.danger-button{background:#fff;color:#d44141;border:1rpx solid #ecabab}.role-row,.actions{display:flex;gap:12rpx}.role{padding:10rpx 20rpx;border:1rpx solid #f4d9c3;border-radius:26rpx;color:#82644d;font-size:23rpx}.role.active{color:#fff;background:#ff7614;border-color:#ff7614}.invite{padding:18rpx 0;border-bottom:1rpx solid #f7ece1}.invite-code{font-size:27rpx;font-weight:700}.actions{margin-top:12rpx;color:#d86b1b;font-size:23rpx}.danger-text{color:#ca4e45}.error{padding:20rpx;margin-bottom:20rpx;color:#b93b3b;font-size:24rpx}.retry{color:#f47716}
